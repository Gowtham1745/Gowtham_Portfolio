---
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects.js';
import { experiences } from '../data/experience';
import { achievements } from '../data/achievements';
import MultiAgentCursor from '../components/react/MultiAgentCursor.tsx';

const base = import.meta.env.BASE_URL;
const stats = [
  { value: String(projects.length).padStart(2, '0'), label: 'Projects documented' },
  { value: String(experiences.length).padStart(2, '0'), label: 'Experience entries' },
  { value: String(achievements.length).padStart(2, '0'), label: 'Award entries' },
];
---
<section class="hero-redesign hero-cinematic-premium" data-hero data-hero-redesign aria-labelledby="hero-name">
  <div class="hero-redesign-grid" aria-hidden="true"></div>
  <div class="cursor-swarm-layer" id="cursor-swarm" aria-hidden="true"></div>
  <div class="hero-redesign-glow" aria-hidden="true"></div>
  <div class="hero-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero-redesign-word-wrap" data-parallax="text" aria-hidden="true">
    <h1 class="hero-redesign-word">GOWTHAM</h1>
    <p class="hero-redesign-word-caption">DESIGN · ENGINEERING · SIMULATION · VISUAL STORYTELLING</p>
  </div>

  <div class="hero-redesign-photo" data-parallax="portrait" aria-hidden="true">
    <div class="hero-photo-aura"></div>
    <div class="hero-photo-floor"></div>
    <img
      src={`${base}media/gowtham-full.png`}
      alt=""
      class="hero-redesign-cutout"
      fetchpriority="high"
      decoding="async"
      width="1152"
      height="2047"
    />
    <span class="hero-photo-index">GA / 01</span>
  </div>

  <div class="hero-redesign-shell">
    <div class="hero-redesign-left" data-parallax="copy">
      <p class="hero-redesign-script">Hello, I'm</p>
      <div class="hero-redesign-name-row">
        <h2 id="hero-name">{siteConfig.name}</h2>
        <img
          class="hero-redesign-profile"
          data-profile-focus
          src={`${base}media/profile-professional.jpg`}
          alt="Gowtham A"
          width="88"
          height="88"
          loading="eager"
          decoding="async"
        />
      </div>
      <p class="hero-redesign-role">{siteConfig.role}</p>
      <p class="hero-redesign-intro">{siteConfig.headline}</p>
      <div class="hero-redesign-actions">
        <a class="hero-redesign-cta" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="hero-redesign-cta hero-resume-cta" href={`${base}media/Resume/Gowtham_A_Resume.pdf`} download>
          <span aria-hidden="true">↓</span> Download Resume
        </a>
      </div>
      <p class="hero-redesign-location">{siteConfig.location}</p>

      <div class="follow-card hero-follow-card" id="follow-card" data-base="517">
        <div class="follow-count">
          <strong id="follow-count" aria-live="polite">517</strong>
          <span>connections</span>
        </div>
        <button type="button" class="button follow-button" id="follow-button" aria-pressed="false">
          <span id="follow-label">Follow</span>
        </button>
      </div>
      <div class="hero-social-links">
        <a class="hero-social-link" href={siteConfig.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham LinkedIn profile">LinkedIn</a>
        <a class="hero-social-link" href={siteConfig.contact.github} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham GitHub profile">GitHub</a>
        <a class="hero-social-link" href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Contact Gowtham on WhatsApp">WhatsApp</a>
      </div>
    </div>

    <aside class="hero-redesign-stats" aria-label="Portfolio facts">
      {stats.map((stat) => (
        <div class="hero-redesign-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </aside>
  </div>

  <div class="hero-redesign-bottom">
    <span>INDEPENDENT THINKING. ENGINEERED EXECUTION.</span>
    <span>SCROLL TO EXPLORE ↓</span>
  </div>

  <div class="hero-agent-bar" data-agent-bar aria-live="off">
    <span class="hero-agent-live"><i></i> LIVE DESIGN SESSION</span>
    <span><b data-agent-count>00</b> agents</span>
    <span><b data-layer-count>000</b> layers</span>
    <button type="button" data-agent-skip>Skip intro</button>
  </div>

  {/* Multi-Agent Cursor Collaborative Layout */}
  <div class="multi-agent-section" aria-hidden="true">
    <MultiAgentCursor client:only="react" />
  </div>
</section>


<script is:inline>
  // ============================================================
  // CURSOR SWARM - 6250 Mini Curved Cursors with Content Alignment
  // ============================================================
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) return;

    // Hide native cursor immediately
    document.documentElement.classList.add('has-dune-cursor');

    const ns = 'http://www.w3.org/2000/svg';
    const swarmLayer = document.getElementById('cursor-swarm');
    if (!swarmLayer) return;

    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
    svg.setAttribute('class', 'cursor-swarm-svg');
    svg.setAttribute('aria-hidden', 'true');
    swarmLayer.appendChild(svg);

    // Dune-style curved cursor shape (organic, no sharp edges)
    const CURSOR_PATH = 'M 12 2 C 7 2 3 6 3 11 C 3 14 5 17 8 19 L 12 25 L 16 19 C 19 17 21 14 21 11 C 21 6 17 2 12 2 Z';
    const CURSOR_COUNT = 6250;
    const cursors = [];
    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let mouseActive = false;
    let raf = 0;
    const attractors = [];

    // Create all cursors
    for (let i = 0; i < CURSOR_COUNT; i++) {
      const group = document.createElementNS(ns, 'g');
      group.setAttribute('class', 'swarm-cursor');

      const pointer = document.createElementNS(ns, 'path');
      pointer.setAttribute('d', CURSOR_PATH);
      pointer.setAttribute('fill', '#ffffff');
      pointer.setAttribute('stroke', '#ffffff');
      pointer.setAttribute('stroke-width', '0.4');
      pointer.setAttribute('stroke-linejoin', 'round');
      pointer.setAttribute('stroke-linecap', 'round');
      pointer.setAttribute('opacity', '0.12');
      group.appendChild(pointer);

      // Inner glow dot
      const innerDot = document.createElementNS(ns, 'circle');
      innerDot.setAttribute('cx', '12');
      innerDot.setAttribute('cy', '12');
      innerDot.setAttribute('r', '2.5');
      innerDot.setAttribute('fill', '#ffffff');
      innerDot.setAttribute('opacity', '0.08');
      group.appendChild(innerDot);

      svg.appendChild(group);

      // Random spread across viewport
      const angle = Math.random() * Math.PI * 2;
      const radius = Math.random() * Math.max(window.innerWidth, window.innerHeight) * 0.7;
      const baseX = window.innerWidth / 2 + Math.cos(angle) * radius;
      const baseY = window.innerHeight / 2 + Math.sin(angle) * radius;

      cursors.push({
        group,
        x: baseX,
        y: baseY,
        baseX,
        baseY,
        lag: 0.015 + Math.random() * 0.06,
        angle,
        radius,
        speed: 0.0003 + Math.random() * 0.0015,
        phase: Math.random() * Math.PI * 2,
        orbitAngle: Math.random() * Math.PI * 2,
        orbitSpeed: 0.0002 + Math.random() * 0.0008,
        attraction: 0.25 + Math.random() * 0.35,
        scale: 0.3 + Math.random() * 0.4
      });
    }

    // Register content attractors (sections, text, images)
    function registerAttractors() {
      attractors.length = 0;

      // Sections
      document.querySelectorAll('section[id]').forEach(section => {
        const rect = section.getBoundingClientRect();
        if (rect.width > 50 && rect.height > 50) {
          attractors.push({
            x: rect.left + rect.width / 2,
            y: rect.top + rect.height / 2 + window.scrollY,
            width: rect.width,
            height: rect.height,
            type: 'section',
            strength: 1.2
          });
        }
      });

      // Headlines & important text
      document.querySelectorAll('.section-title, .eyebrow, h2, h3, .featured-meta, .project-category, .skill-detail-header h3, .achievement-kicker, .timeline-type, .hero-redesign-script, .hero-redesign-role, .hero-redesign-intro').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.width > 20) {
          attractors.push({
            x: rect.left + rect.width / 2,
            y: rect.top + rect.height / 2 + window.scrollY,
            width: rect.width,
            height: rect.height,
            type: 'text',
            strength: 0.9
          });
        }
      });

      // Hero photo (strongest attractor)
      const heroPhoto = document.querySelector('.hero-redesign-photo');
      if (heroPhoto) {
        const rect = heroPhoto.getBoundingClientRect();
        attractors.push({
          x: rect.left + rect.width / 2,
          y: rect.top + rect.height / 2 + window.scrollY,
          width: rect.width,
          height: rect.height,
          type: 'photo',
          strength: 2.5
        });
      }

      // Project images/cards
      document.querySelectorAll('.project-image, .featured-media, .achievement-hero-image').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.width > 30) {
          attractors.push({
            x: rect.left + rect.width / 2,
            y: rect.top + rect.height / 2 + window.scrollY,
            width: rect.width,
            height: rect.height,
            type: 'media',
            strength: 1.0
          });
        }
      });

      // Buttons & interactive elements
      document.querySelectorAll('a.button, button, .follow-button, .hero-redesign-cta').forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.width > 20) {
          attractors.push({
            x: rect.left + rect.width / 2,
            y: rect.top + rect.height / 2 + window.scrollY,
            width: rect.width,
            height: rect.height,
            type: 'button',
            strength: 0.7
          });
        }
      });
    }

    // Mouse/touch tracking
    const move = (clientX, clientY) => {
      targetX = clientX;
      targetY = clientY;
      mouseActive = true;
      swarmLayer.classList.add('is-visible');
    };

    window.addEventListener('pointermove', e => move(e.clientX, e.clientY), { passive: true });
    window.addEventListener('touchmove', e => {
      if (e.touches[0]) move(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener('pointerleave', () => { mouseActive = false; });
    window.addEventListener('pointerenter', () => { mouseActive = true; swarmLayer.classList.add('is-visible'); });

    // Animation loop
    function animate() {
      // Periodically refresh attractors
      if (Math.random() < 0.008) registerAttractors();

      cursors.forEach(cursor => {
        // Mouse attraction
        let dx = targetX - cursor.x;
        let dy = targetY - cursor.y;
        let dist = Math.sqrt(dx * dx + dy * dy);

        if (mouseActive && dist > 1) {
          cursor.x += dx * cursor.lag * cursor.attraction;
          cursor.y += dy * cursor.lag * cursor.attraction;
        }

        // Content attraction - cursors align to text, photos, sections
        attractors.forEach(attr => {
          const adx = attr.x - cursor.x;
          const ady = attr.y - cursor.y;
          const adist = Math.sqrt(adx * adx + ady * ady);
          const maxDist = Math.max(attr.width, attr.height) * 1.8 + 300;

          if (adist < maxDist && adist > 8) {
            const force = (1 - adist / maxDist) * attr.strength * 0.018;
            cursor.x += adx * force;
            cursor.y += ady * force;
          }
        });

        // Organic orbital drift (zigzag flow)
        cursor.phase += cursor.speed;
        cursor.orbitAngle += cursor.orbitSpeed;
        const driftX = Math.sin(cursor.phase) * 40 + Math.cos(cursor.orbitAngle) * 25;
        const driftY = Math.cos(cursor.phase * 0.7) * 30 + Math.sin(cursor.orbitAngle * 1.3) * 20;
        cursor.x += (cursor.baseX + driftX - cursor.x) * 0.0008;
        cursor.y += (cursor.baseY + driftY - cursor.y) * 0.0008;

        // Boundary wrap (infinite canvas)
        if (cursor.x < -80) cursor.x = window.innerWidth + 80;
        if (cursor.x > window.innerWidth + 80) cursor.x = -80;
        if (cursor.y < -80) cursor.y = window.innerHeight + 80;
        if (cursor.y > window.innerHeight + 80) cursor.y = -80;

        // Dynamic scale based on mouse proximity
        const scale = mouseActive ? Math.max(0.25, cursor.scale * (1 - dist / 1000)) : cursor.scale * 0.6;
        cursor.group.setAttribute('transform', `translate(${cursor.x} ${cursor.y}) scale(${scale})`);

        // Opacity - always visible, brighter near mouse/content
        const baseOpacity = mouseActive ? 0.5 : 0.35;
        const opacity = Math.min(0.9, baseOpacity + (1 - dist / 1500) * 0.4);
        cursor.group.setAttribute('opacity', opacity.toString());
      });

      raf = requestAnimationFrame(animate);
    }

    // Resize handler
    window.addEventListener('resize', () => {
      svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
      targetX = window.innerWidth / 2;
      targetY = window.innerHeight / 2;
      registerAttractors();
    }, { passive: true });

    // Scroll handler - update attractors
    let scrollTimeout;
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(registerAttractors, 50);
    }, { passive: true });

    // Visibility
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else animate();
    });

    // Initialize
    registerAttractors();
    swarmLayer.classList.add('is-visible');
    animate();
  })();
</script>


<script is:inline>
  // ============================================================
  // HERO SCROLL PARALLAX
  // ============================================================
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const heroRoot = document.querySelector('[data-hero-redesign]');
  if (heroRoot && !reducedMotion.matches) {
    let scrollFrame = 0;
    const updateDepth = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        const rect = heroRoot.getBoundingClientRect();
        const progress = Math.max(-1, Math.min(1, -rect.top / Math.max(rect.height, 1)));
        heroRoot.style.setProperty('--hero-scroll-depth', progress.toFixed(3));
        document.body.style.setProperty('--page-scroll-offset', (window.scrollY * -0.075).toFixed(1) + 'px');
        scrollFrame = 0;
      });
    };
    window.addEventListener('scroll', updateDepth, { passive: true });
    updateDepth();
  }
</script>

<style is:global>
  /* ============================================================
     CURSOR SWARM - Visible Immediately, Full Viewport
     ============================================================ */
  .cursor-swarm-layer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
    opacity: 1;
    display: block;
  }
  .cursor-swarm-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .swarm-cursor {
    transform-origin: 12px 12px;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.7));
    will-change: transform, opacity;
  }
  .has-dune-cursor,
  .has-dune-cursor body,
  .has-dune-cursor body * {
    cursor: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor-swarm-layer { display: none !important; }
    .has-dune-cursor, .has-dune-cursor body, .has-dune-cursor body * { cursor: auto !important; }
  }

  /* ============================================================
     HERO PHOTO - Centered on ALL Desktop/Laptop Screens
     ============================================================ */
  .hero-cinematic-premium .hero-redesign-photo {
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: clamp(370px, 48vw, 700px);
    height: 94%;
    z-index: 2;
    filter: drop-shadow(0 28px 58px rgba(0,0,0,0.35));
    transition: transform .08s linear, filter .3s ease;
  }

  /* ============================================================
     ENHANCED SCROLL PARALLAX
     ============================================================ */
  .hero-cinematic-premium .hero-redesign-grid {
    transform: translate3d(0, calc(var(--hero-scroll-depth,0) * -30px), 0);
    transition: transform .08s linear;
  }
  .hero-cinematic-premium .hero-redesign-glow {
    background-position: 0 calc(var(--hero-scroll-depth,0) * 25px);
  }
  .hero-cinematic-premium .hero-redesign-photo {
    transform: translate3d(-50%, calc(var(--hero-scroll-depth,0) * 20px), 0);
    transition: transform .08s linear;
  }
  .hero-cinematic-premium .hero-redesign-cutout {
    transform: scale(calc(1 + var(--hero-scroll-depth,0) * 0.02));
    transition: transform .08s linear, filter .3s ease;
  }
  body {
    background-position: 0 var(--page-scroll-offset,0px), 0 var(--page-scroll-offset,0px);
    background-attachment: fixed;
  }

  .hero-redesign-profile { border-radius: 0 !important; object-fit: cover; }
  .hero-follow-card { width: max-content; }
  .hero-social-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .hero-social-link {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .5rem .85rem;
    border: 1px solid rgba(171,220,207,.25);
    border-radius: 6px;
    background: rgba(5,17,22,.7);
    color: #e7c994;
    font: 600 .58rem 'IBM Plex Mono',monospace;
    text-decoration: none; white-space: nowrap;
    transition: all .2s ease;
  }
  .hero-social-link:hover {
    background: rgba(183,226,214,.15);
    color: #fff;
    border-color: #b7e2dc;
  }

  @media (max-width: 900px) {
    .hero-cinematic-premium .hero-redesign-photo { width: 65vw; height: 85%; opacity: .96; }
  }

  @media (max-width: 680px) {
    .hero-cinematic-premium .hero-redesign-photo {
      transform: translate3d(-50%, calc(var(--hero-scroll-depth,0) * 8px), 0) scale(1.055) !important;
      transform-origin: 50% 72%; overflow: hidden;
    }
    .hero-cinematic-premium .hero-redesign-cutout {
      object-fit: contain; object-position: center bottom;
      transform: scale(1.075); transform-origin: 50% 72%;
      filter: drop-shadow(0 15px 30px rgba(0,0,0,.45));
    }
    .hero-follow-card { width: 100%; justify-content: space-between; gap: .5rem; padding: .6rem; }
    .hero-follow-card .follow-count strong { font-size: 1.2rem; }
    .hero-social-links { width: 100%; justify-content: center; }
    .hero-social-link { padding: .45rem .75rem; font-size: .54rem; }
  }
  @media (max-width: 380px) {
    .hero-follow-card .follow-count strong { font-size: 1.1rem; }
    .hero-social-link { padding: .4rem .6rem; font-size: .5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cinematic-premium .hero-redesign-grid,
    .hero-cinematic-premium .hero-redesign-photo,
    .hero-cinematic-premium .hero-redesign-cutout { transform: none !important; }
  }

  /* ============================================================
     MULTI-AGENT CURSOR COLLABORATIVE LAYOUT
     ============================================================ */
  .multi-agent-section {
    position: absolute;
    inset: 0;
    z-index: 15;
    pointer-events: none;
    overflow: visible;
  }
  .multi-agent-section > div {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 768px) {
    .multi-agent-section { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .multi-agent-section { display: none; }
  }
</style>