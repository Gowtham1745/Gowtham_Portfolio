---
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects.js';
import { experiences } from '../data/experience';
import { achievements } from '../data/achievements';

const base = import.meta.env.BASE_URL;
const stats = [
  { value: String(projects.length).padStart(2, '0'), label: 'Projects documented' },
  { value: String(experiences.length).padStart(2, '0'), label: 'Experience entries' },
  { value: String(achievements.length).padStart(2, '0'), label: 'Award entries' },
];
---
<section class="hero-clean" data-hero aria-labelledby="hero-name">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-shell">
    <div class="hero-left">
      <p class="hero-script">Hello, I'm</p>
      <div class="hero-name-row">
        <h2 id="hero-name">{siteConfig.name}</h2>
        <img
          class="hero-profile"
          src={`${base}media/profile-professional.jpg`}
          alt="Gowtham A"
          width="88"
          height="88"
          loading="eager"
          decoding="async"
        />
      </div>
      <p class="hero-role">{siteConfig.role}</p>
      <p class="hero-intro">{siteConfig.headline}</p>
      <div class="hero-actions">
        <a class="hero-cta" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="hero-cta hero-resume-cta" href={`${base}media/Resume/Gowtham_A_Resume.pdf`} download>
          <span aria-hidden="true">↓</span> Download Resume
        </a>
      </div>
      <p class="hero-location">{siteConfig.location}</p>

      <div class="follow-card" id="follow-card" data-base="517">
        <div class="follow-count">
          <strong id="follow-count" aria-live="polite">517</strong>
          <span>connections</span>
        </div>
        <button type="button" class="button follow-button" id="follow-button" aria-pressed="false">
          <span id="follow-label">Follow</span>
        </button>
      </div>
      <div class="hero-social-links">
        <a class="hero-social-link" href={siteConfig.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham LinkedIn profile">LinkedIn</a>
        <a class="hero-social-link" href={siteConfig.contact.github} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham GitHub profile">GitHub</a>
        <a class="hero-social-link" href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Contact Gowtham on WhatsApp">WhatsApp</a>
      </div>
    </div>

    <aside class="hero-stats" aria-label="Portfolio facts">
      {stats.map((stat) => (
        <div class="hero-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </aside>
  </div>

  <div class="hero-bottom">
    <span>INDEPENDENT THINKING. ENGINEERED EXECUTION.</span>
    <span>SCROLL TO EXPLORE ↓</span>
  </div>

  <div class="hero-full-photo" aria-hidden="true">
    <img
      src={`${base}media/gowtham-full.png`}
      alt=""
      class="hero-full-cutout"
      loading="lazy"
      decoding="async"
      width="1152"
      height="2047"
    />
  </div>
</section>
    <script>
      import '../scripts/hero-experience.js';
    </script>

<style is:global>
  /* Hero Clean - Fast, No Heavy Animations */
  .hero-clean {
    position: relative;
    isolation: isolate;
    min-height: min(850px, calc(100svh - 3.5rem));
    background: #070708;
    color: #f7f5f5;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.15;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 70% 30%, rgba(240,68,82,.12), transparent 50%),
      radial-gradient(ellipse at 30% 80%, rgba(240,184,102,.08), transparent 40%);
  }

  .hero-shell {
    position: relative;
    z-index: 10;
    width: min(1160px, calc(100% - 3rem));
    margin-inline: auto;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(320px, 1fr) minmax(180px, 0.4fr);
    align-items: center;
    gap: 2rem;
    padding-block: clamp(5rem, 12vh, 8rem) 4rem;
  }

  .hero-left { max-width: 580px; }

  .hero-script {
    margin: 0 0 0.5rem;
    color: #f4a1a7;
    font: italic 500 clamp(1.3rem, 2.5vw, 2rem) Georgia, serif;
  }

  .hero-name-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-name-row h2 {
    margin: 0;
    color: #fff;
    font: 800 clamp(2.4rem, 5vw, 4.2rem)/.98 'Space Grotesk', sans-serif;
    letter-spacing: -0.06em;
  }

  .hero-profile {
    flex: 0 0 auto;
    width: clamp(56px, 7vw, 88px);
    height: clamp(56px, 7vw, 88px);
    object-fit: cover;
    object-position: center 24%;
    border: 2px solid rgba(240,68,82,.8);
    border-radius: 0;
    box-shadow: 0 0 0 5px rgba(240,68,82,.09);
  }

  .hero-role {
    margin: 1rem 0 0.5rem;
    color: #ff6874;
    font: 600 0.7rem 'IBM Plex Mono', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-intro {
    max-width: 48ch;
    margin: 0;
    color: #e1dcde;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: #f04452;
    border: 1px solid #f04452;
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 10px 28px rgba(240,68,82,.2);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .hero-cta:hover { transform: translateY(-2px); background: #ff5966; }

  .hero-resume-cta {
    background: rgba(7,20,25,.58);
    color: #e8f3ee;
    border-color: rgba(224,196,148,.62);
    box-shadow: 0 8px 26px rgba(0,0,0,.18);
  }

  .hero-resume-cta:hover {
    background: rgba(196,161,108,.16);
    color: #fff;
    border-color: #e9c58c;
  }

  .hero-location {
    margin: 1rem 0 0;
    color: #c4bec1;
    font: 500 0.65rem 'IBM Plex Mono', monospace;
    letter-spacing: 0.05em;
  }

  .follow-card {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.2rem;
    padding: 0.7rem 0.9rem 0.7rem 1.1rem;
    border: 1px solid rgba(171,220,207,.25);
    border-radius: 9px;
    background: rgba(5,17,22,.7);
    box-shadow: 0 10px 30px rgba(0,0,0,.18);
    backdrop-filter: blur(12px);
  }

  .follow-count { display: flex; flex-direction: column; line-height: 1.1; }
  .follow-count strong { font: 800 1.4rem/1 'Space Grotesk', sans-serif; color: #effaf5; letter-spacing: -0.03em; }
  .follow-count span { color: #b7cfc6; font-size: 0.65rem; }

  .follow-button {
    min-height: 36px;
    padding: 0.5rem 0.85rem;
    border: 0;
    cursor: pointer;
    border-radius: 6px;
    background: #f04452;
    color: #fff;
    font: 600 0.67rem 'IBM Plex Mono', monospace;
    transition: all 0.2s ease;
  }

  .follow-button:hover:not(:disabled) { background: #ff5966; }
  .follow-button.is-following {
    background: transparent;
    color: #8ed9c5;
    border: 1px solid #8ed9c5;
    cursor: default;
  }

  .hero-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hero-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid rgba(171,220,207,.25);
    border-radius: 6px;
    background: rgba(5,17,22,.7);
    color: #e7c994;
    font: 600 0.58rem 'IBM Plex Mono', monospace;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hero-social-link:hover {
    background: rgba(183,226,214,.15);
    color: #fff;
    border-color: #b7e2dc;
  }

  .hero-stats {
    justify-self: end;
    align-self: center;
    display: grid;
    gap: 0.8rem;
    width: min(200px, 100%);
  }

  .hero-stat {
    padding: 0.9rem 1rem;
    border: 1px solid rgba(240,68,82,.35);
    background: rgba(10,10,10,.78);
    backdrop-filter: blur(8px);
  }

  .hero-stat strong { display: block; color: #fff; font: 700 1.8rem/1 'Space Grotesk', sans-serif; }
  .hero-stat span { display: block; margin-top: 0.35rem; color: #d0c6c9; font-size: 0.65rem; line-height: 1.4; }

  .hero-bottom {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    width: min(1160px, calc(100% - 3rem));
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #bcb3b6;
    font: 500 0.54rem 'IBM Plex Mono', monospace;
    letter-spacing: 0.12em;
    pointer-events: none;
  }

  .hero-bottom span:last-child { color: #ff6974; }

  .hero-full-photo {
    position: absolute;
    right: clamp(1rem, 5vw, 4rem);
    bottom: 0;
    z-index: 2;
    width: clamp(280px, 35vw, 500px);
    height: 85%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }

  .hero-full-cutout {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,.45));
  }

  /* Mobile */
  @media (max-width: 900px) {
    .hero-clean { min-height: 780px; }
    .hero-shell { grid-template-columns: minmax(0, 1fr) 160px; padding-top: 10rem; }
    .hero-full-photo { right: 5%; width: 45vw; height: 70%; opacity: 0.9; }
    .hero-left { max-width: 500px; }
  }

  @media (max-width: 680px) {
    .hero-clean { min-height: auto; padding-bottom: 4rem; }
    .hero-shell {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      width: calc(100% - 2rem);
      padding: 14rem 0 3rem;
    }
    .hero-left { max-width: none; }
    .hero-name-row { gap: 0.75rem; }
    .hero-name-row h2 { font-size: clamp(2.2rem, 9vw, 3rem); }
    .hero-profile { width: 56px; height: 56px; }
    .hero-role { font-size: 0.58rem; margin-top: 0.7rem; }
    .hero-intro { font-size: 0.9rem; line-height: 1.6; max-width: 52ch; }
    .hero-cta { min-height: 48px; margin-top: 1rem; }
    .hero-stats { width: 100%; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
    .hero-stat { padding: 0.6rem 0.5rem; }
    .hero-stat strong { font-size: 1.3rem; }
    .hero-stat span { font-size: 0.56rem; }
    .hero-bottom { bottom: 0.8rem; width: calc(100% - 2rem); font-size: 0.4rem; letter-spacing: 0.06em; }
    .hero-full-photo {
      position: relative;
      right: auto;
      bottom: auto;
      left: 50%;
      transform: translateX(-50%);
      width: min(85vw, 380px);
      height: 45%;
      opacity: 1;
      margin-top: 1rem;
    }
    .hero-full-cutout {
      object-fit: contain;
      object-position: center bottom;
      filter: drop-shadow(0 12px 28px rgba(0,0,0,.4));
    }
    .follow-card { width: 100%; justify-content: space-between; gap: 0.5rem; padding: 0.6rem; }
    .hero-social-links { width: 100%; justify-content: center; }
    .hero-social-link { padding: 0.45rem 0.75rem; font-size: 0.54rem; }
  }

  @media (max-width: 380px) {
    .hero-clean { min-height: auto; }
    .hero-shell { padding-top: 12rem; }
    .hero-full-photo { width: 88vw; height: 40%; }
    .hero-name-row h2 { font-size: clamp(2rem, 10vw, 2.5rem); }
    .hero-stat strong { font-size: 1.15rem; }
    .hero-social-link { padding: 0.4rem 0.6rem; font-size: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta, .hero-social-link, .follow-button { transition: none; }
    html { scroll-behavior: auto; }
  }
</style>