---
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects.js';
import { experiences } from '../data/experience';
import { achievements } from '../data/achievements';

const base = import.meta.env.BASE_URL;
const stats = [
  { value: String(projects.length).padStart(2, '0'), label: 'Projects documented' },
  { value: String(experiences.length).padStart(2, '0'), label: 'Experience entries' },
  { value: String(achievements.length).padStart(2, '0'), label: 'Award entries' },
];
---
<section class="hero-redesign hero-cinematic-premium" data-hero data-hero-redesign aria-labelledby="hero-name">
  <div class="hero-redesign-grid" aria-hidden="true"></div>
  <div class="cursor-swarm-layer" id="cursor-swarm" aria-hidden="true"></div>
  <div class="hero-redesign-glow" aria-hidden="true"></div>
  <div class="hero-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero-redesign-word-wrap" data-parallax="text" aria-hidden="true">
    <h1 class="hero-redesign-word">GOWTHAM</h1>
    <p class="hero-redesign-word-caption">DESIGN · ENGINEERING · SIMULATION · VISUAL STORYTELLING</p>
  </div>

  <div class="hero-redesign-photo" data-parallax="portrait" aria-hidden="true">
    <div class="hero-photo-aura"></div>
    <div class="hero-photo-floor"></div>
    <img
      src={`${base}media/gowtham-full.png`}
      alt=""
      class="hero-redesign-cutout"
      fetchpriority="high"
      decoding="async"
      width="1152"
      height="2047"
    />
    <span class="hero-photo-index">GA / 01</span>
  </div>

  <div class="hero-redesign-shell">
    <div class="hero-redesign-left" data-parallax="copy">
      <p class="hero-redesign-script">Hello, I'm</p>
      <div class="hero-redesign-name-row">
        <h2 id="hero-name">{siteConfig.name}</h2>
        <img
          class="hero-redesign-profile"
          data-profile-focus
          src={`${base}media/profile-professional.jpg`}
          alt="Gowtham A"
          width="88"
          height="88"
          loading="eager"
          decoding="async"
        />
      </div>
      <p class="hero-redesign-role">{siteConfig.role}</p>
      <p class="hero-redesign-intro">{siteConfig.headline}</p>
      <div class="hero-redesign-actions">
        <a class="hero-redesign-cta" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="hero-redesign-cta hero-resume-cta" href={`${base}media/Resume/Gowtham_A_Resume.pdf`} download>
          <span aria-hidden="true">↓</span> Download Resume
        </a>
      </div>
      <p class="hero-redesign-location">{siteConfig.location}</p>

      <div class="follow-card hero-follow-card" id="follow-card" data-base="517">
        <div class="follow-count">
          <strong id="follow-count" aria-live="polite">517</strong>
          <span>connections</span>
        </div>
        <button type="button" class="button follow-button" id="follow-button" aria-pressed="false">
          <span id="follow-label">Follow</span>
        </button>
      </div>
      <div class="hero-social-links">
        <a class="hero-social-link" href={siteConfig.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham LinkedIn profile">LinkedIn</a>
        <a class="hero-social-link" href={siteConfig.contact.github} target="_blank" rel="noopener noreferrer" aria-label="Open Gowtham GitHub profile">GitHub</a>
        <a class="hero-social-link" href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Contact Gowtham on WhatsApp">WhatsApp</a>
      </div>
    </div>

    <aside class="hero-redesign-stats" aria-label="Portfolio facts">
      {stats.map((stat) => (
        <div class="hero-redesign-stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </aside>
  </div>

  <div class="hero-redesign-bottom">
    <span>INDEPENDENT THINKING. ENGINEERED EXECUTION.</span>
    <span>SCROLL TO EXPLORE ↓</span>
  </div>

  <div class="hero-agent-bar" data-agent-bar aria-live="off">
    <span class="hero-agent-live"><i></i> LIVE DESIGN SESSION</span>
    <span><b data-agent-count>00</b> agents</span>
    <span><b data-layer-count>000</b> layers</span>
    <button type="button" data-agent-skip>Skip intro</button>
  </div>
</section>


<script>
  // ============================================================
  // CURSOR SWARM - 6250 Organic Cursors with Content Interaction
  // ============================================================
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches) {      document.documentElement.classList.add("has-dune-cursor");
    const ns = 'http://www.w3.org/2000/svg';
    const swarmLayer = document.getElementById('cursor-swarm');
    if (swarmLayer) {
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('viewBox', '0 0 ' + window.innerWidth + ' ' + window.innerHeight);
      svg.setAttribute('class', 'cursor-swarm-svg');
      svg.setAttribute('aria-hidden', 'true');
      swarmLayer.appendChild(svg);

      // Dune-style cursor shape (curved, organic, no sharp edges)
      const cursorPath = 'M 12 2 C 7 2 3 6 3 11 C 3 14 5 17 8 19 L 12 25 L 16 19 C 19 17 21 14 21 11 C 21 6 17 2 12 2 Z';
      const CURSOR_COUNT = 6250;
      
      // Type definitions
      interface Cursor {
        group: SVGGElement;
        x: number;
        y: number;
        baseX: number;
        baseY: number;
        lag: number;
        angle: number;
        radius: number;
        speed: number;
        phase: number;
        targetX: number;
        targetY: number;
        attraction: number;
      }
      
      interface Attractor {
        x: number;
        y: number;
        width: number;
        height: number;
        id: string;
        strength: number;
      }
      
      const cursors: Cursor[] = [];
      const groups: SVGGElement[] = [];

      // Create cursor groups
      for (let i = 0; i < CURSOR_COUNT; i++) {
        const group = document.createElementNS(ns, 'g');
        group.setAttribute('class', 'swarm-cursor');
        
        const pointer = document.createElementNS(ns, 'path');
        pointer.setAttribute('d', cursorPath);
        pointer.setAttribute('fill', '#ffffff');
        pointer.setAttribute('stroke', '#ffffff');
        pointer.setAttribute('stroke-width', '0.5');
        pointer.setAttribute('stroke-linejoin', 'round');
        pointer.setAttribute('stroke-linecap', 'round');
        pointer.setAttribute('opacity', '0.15');
        group.appendChild(pointer);
        
        // Inner glow
        const innerRing = document.createElementNS(ns, 'circle');
        innerRing.setAttribute('cx', '12');
        innerRing.setAttribute('cy', '12');
        innerRing.setAttribute('r', '4');
        innerRing.setAttribute('fill', 'none');
        innerRing.setAttribute('stroke', '#ffffff');
        innerRing.setAttribute('stroke-width', '0.3');
        innerRing.setAttribute('opacity', '0.1');
        group.appendChild(innerRing);
        
        svg.appendChild(group);
        groups.push(group);
        
        // Random initial positions across viewport
        const angle = Math.random() * Math.PI * 2;
        const radius = Math.random() * Math.max(window.innerWidth, window.innerHeight) * 0.6;
        cursors.push({
          group,
          x: window.innerWidth / 2 + Math.cos(angle) * radius,
          y: window.innerHeight / 2 + Math.sin(angle) * radius,
          baseX: window.innerWidth / 2 + Math.cos(angle) * radius,
          baseY: window.innerHeight / 2 + Math.sin(angle) * radius,
          lag: 0.02 + Math.random() * 0.08, // Varied lag for organic movement
          angle: angle,
          radius: radius,
          speed: 0.0005 + Math.random() * 0.002,
          phase: Math.random() * Math.PI * 2,
          targetX: window.innerWidth / 2,
          targetY: window.innerHeight / 2,
          attraction: 0.3 + Math.random() * 0.4
        });
      }

      let targetX = window.innerWidth / 2;
      let targetY = window.innerHeight / 2;
      let mouseActive = false;
      let raf = 0;

      // Content attractors - sections that pull cursors
      const attractors: Attractor[] = [];
      function registerAttractors() {
        attractors.length = 0;
        const sections = document.querySelectorAll('section[id]');
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          if (rect.width > 0 && rect.height > 0) {
            attractors.push({
              x: rect.left + rect.width / 2,
              y: rect.top + rect.height / 2 + window.scrollY,
              width: rect.width,
              height: rect.height,
              id: section.id,
              strength: 1.0
            });
          }
        });
        // Add specific text highlights
        const highlights = document.querySelectorAll('.section-title, .eyebrow, h2, h3, .featured-meta, .project-category, .skill-detail-header h3, .achievement-kicker, .timeline-type');
        highlights.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.width > 0) {
            attractors.push({
              x: rect.left + rect.width / 2,
              y: rect.top + rect.height / 2 + window.scrollY,
              width: rect.width,
              height: rect.height,
              id: 'text-' + Math.random(),
              strength: 0.8
            });
          }
        });
        // Hero photo attractor
        const heroPhoto = document.querySelector('.hero-redesign-photo');
        if (heroPhoto) {
          const rect = heroPhoto.getBoundingClientRect();
          attractors.push({
            x: rect.left + rect.width / 2,
            y: rect.top + rect.height / 2 + window.scrollY,
            width: rect.width,
            height: rect.height,
            id: 'hero-photo',
            strength: 2.0
          });
        }
      }

      const move = (event: PointerEvent) => {
        targetX = event.clientX;
        targetY = event.clientY;
        mouseActive = true;
        swarmLayer.classList.add('is-visible');
      };

      const animate = () => {
        // Update attractors periodically
        if (Math.random() < 0.01) registerAttractors();
        
        cursors.forEach((cursor) => {
          let dx = targetX - cursor.x;
          let dy = targetY - cursor.y;
          let dist = Math.sqrt(dx * dx + dy * dy);
          
          // Mouse attraction
          if (mouseActive && dist > 1) {
            cursor.x += dx * cursor.lag * cursor.attraction;
            cursor.y += dy * cursor.lag * cursor.attraction;
          }
          
          // Content attractors - cursors flow toward content
          attractors.forEach(attr => {
            const adx = attr.x - cursor.x;
            const ady = attr.y - cursor.y;
            const adist = Math.sqrt(adx * adx + ady * ady);
            const maxDist = Math.max(attr.width, attr.height) * 1.5 + 200;
            
            if (adist < maxDist && adist > 5) {
              const force = (1 - adist / maxDist) * attr.strength * 0.02;
              cursor.x += adx * force;
              cursor.y += ady * force;
            }
          });
          
          // Organic ambient drift (zigzag/organic movement)
          cursor.phase += cursor.speed;
          const driftX = Math.sin(cursor.phase) * 30;
          const driftY = Math.cos(cursor.phase * 0.7) * 20;
          cursor.x += (cursor.baseX + driftX - cursor.x) * 0.001;
          cursor.y += (cursor.baseY + driftY - cursor.y) * 0.001;
          
          // Boundary wrap
          if (cursor.x < -50) cursor.x = window.innerWidth + 50;
          if (cursor.x > window.innerWidth + 50) cursor.x = -50;
          if (cursor.y < -50) cursor.y = window.innerHeight + 50;
          if (cursor.y > window.innerHeight + 50) cursor.y = -50;
          
          // Scale based on distance to mouse
          const scale = mouseActive ? Math.max(0.3, 1 - dist / 800) : 0.4;
          cursor.group.setAttribute('transform', 'translate(' + cursor.x + ' ' + cursor.y + ') scale(' + scale + ')');
          
          // Opacity based on activity
          const opacity = mouseActive ? Math.max(0.05, 0.3 - dist / 1200) : 0.12;
          cursor.group.setAttribute('opacity', opacity.toString());
        });
        
        raf = requestAnimationFrame(animate);
      };

      window.addEventListener('resize', () => {
        svg.setAttribute('viewBox', '0 0 ' + window.innerWidth + ' ' + window.innerHeight);
        targetX = window.innerWidth / 2;
        targetY = window.innerHeight / 2;
        registerAttractors();
      }, { passive: true });

      window.addEventListener('pointermove', move, { passive: true });
      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          targetX = e.touches[0].clientX;
          targetY = e.touches[0].clientY;
          mouseActive = true;
          swarmLayer.classList.add('is-visible');
        }
      }, { passive: true });
      
      window.addEventListener('pointerleave', () => { mouseActive = false; swarmLayer.classList.remove('is-visible'); });
      window.addEventListener('pointerenter', () => { mouseActive = true; swarmLayer.classList.add('is-visible'); });
      
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else animate();      swarmLayer.classList.add("is-visible");
      });
      
      window.addEventListener('scroll', () => {
        registerAttractors();
      }, { passive: true });

      // Initial registration
      setTimeout(registerAttractors, 100);
      animate();      swarmLayer.classList.add("is-visible");
      
      // Hide native cursor
      document.documentElement.classList.add('has-dune-cursor');
    }
  }

  // ============================================================
  // HERO SCROLL PARALLAX
  // ============================================================
  const heroRoot = document.querySelector<HTMLElement>('[data-hero-redesign]');
  if (heroRoot && !reducedMotion.matches) {
    let scrollFrame = 0;
    const updateDepth = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        const rect = heroRoot.getBoundingClientRect();
        const progress = Math.max(-1, Math.min(1, -rect.top / Math.max(rect.height, 1)));
        heroRoot.style.setProperty('--hero-scroll-depth', progress.toFixed(3));
        document.body.style.setProperty('--page-scroll-offset', (window.scrollY * -0.075).toFixed(1) + 'px');
        scrollFrame = 0;
      });
    };
    window.addEventListener('scroll', updateDepth, { passive: true });
    updateDepth();
  }
</script>

<style is:global>
  /* Cursor Swarm Layer */
  .cursor-swarm-layer { position:fixed; inset:0; z-index:9999; pointer-events:none; overflow:hidden; opacity:1; transition:opacity .3s ease; display:block; }
  .cursor-swarm-layer.is-visible { opacity:1; }
  .cursor-swarm-svg { display:block; width:100%; height:100%; overflow:visible; }
  .swarm-cursor { transform-origin:12px 12px; filter:drop-shadow(0 1px 3px rgba(0,0,0,.6)); will-change:transform,opacity; }
  .has-dune-cursor, .has-dune-cursor body, .has-dune-cursor body * { cursor:none !important; }
  @media (prefers-reduced-motion:reduce) { .cursor-swarm-layer { display:none!important; } .has-dune-cursor, .has-dune-cursor body, .has-dune-cursor body * { cursor:auto !important; } }

  /* Hero Photo Centered on ALL desktop/laptop sizes */
  .hero-cinematic-premium .hero-redesign-photo {
    left:50% !important;
    transform:translateX(-50%) !important;
    width:clamp(370px,48vw,700px);
    height:94%;
    z-index:2;
    filter:drop-shadow(0 28px 58px rgba(0,0,0,.35));
    transition:transform .08s linear, filter .3s ease;
  }

  /* Enhanced Scroll Parallax */
  .hero-cinematic-premium .hero-redesign-grid { transform:translate3d(0,calc(var(--hero-scroll-depth,0) * -30px),0); transition:transform .08s linear; }
  .hero-cinematic-premium .hero-redesign-glow { background-position:0 calc(var(--hero-scroll-depth,0) * 25px); }
  .hero-cinematic-premium .hero-redesign-photo { transform:translate3d(-50%,calc(var(--hero-scroll-depth,0) * 20px),0); transition:transform .08s linear; }
  .hero-cinematic-premium .hero-redesign-cutout { transform:scale(calc(1 + var(--hero-scroll-depth,0) * 0.02)); transition:transform .08s linear, filter .3s ease; }
  body { background-position: 0 var(--page-scroll-offset,0px), 0 var(--page-scroll-offset,0px); background-attachment: fixed; }
  
  .hero-redesign-profile { border-radius:0 !important; object-fit:cover; }
  .hero-follow-card { width:max-content; }
  .hero-social-links { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1rem; }
  .hero-social-link { display:inline-flex; align-items:center; gap:.4rem; padding:.5rem .85rem; border:1px solid rgba(171,220,207,.25); border-radius:6px; background:rgba(5,17,22,.7); color:#e7c994; font:600 .58rem 'IBM Plex Mono',monospace; text-decoration:none; white-space:nowrap; transition:all .2s ease; }
  .hero-social-link:hover { background:rgba(183,226,214,.15); color:#fff; border-color:#b7e2dc; text-decoration:none; }
  
  @media(max-width:900px) {
    .hero-cinematic-premium .hero-redesign-photo { width:65vw; height:85%; opacity:.96; }
  }
  
  @media(max-width:680px) {
    .hero-cinematic-premium .hero-redesign-photo {
      transform:translate3d(-50%,calc(var(--hero-scroll-depth,0) * 8px),0) scale(1.055) !important;
      transform-origin:50% 72%; overflow:hidden;
    }
    .hero-cinematic-premium .hero-redesign-cutout { object-fit:contain; object-position:center bottom; transform:scale(1.075); transform-origin:50% 72%; filter:drop-shadow(0 15px 30px rgba(0,0,0,.45)); }
    .hero-follow-card { width:100%; justify-content:space-between; gap:.5rem; padding:.6rem; }
    .hero-follow-card .follow-count strong { font-size:1.2rem; }
    .hero-social-links { width:100%; justify-content:center; }
    .hero-social-link { padding:.45rem .75rem; font-size:.54rem; }
  }
  @media(max-width:380px) {
    .hero-follow-card .follow-count strong { font-size:1.1rem; }
    .hero-social-link { padding:.4rem .6rem; font-size:.5rem; }
  }
  @media(prefers-reduced-motion:reduce) {
    .hero-cinematic-premium .hero-redesign-grid, .hero-cinematic-premium .hero-redesign-photo, .hero-cinematic-premium .hero-redesign-cutout { transform:none!important; }
  }
</style>
