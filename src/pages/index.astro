.timeline-section { background: linear-gradient(180deg, #07111a, #0a1822); }
.timeline { margin-top: 3.5rem; }
.timeline-item { display: grid; grid-template-columns: 240px 32px 1fr; padding-bottom: 3rem; position: relative; }
.timeline-date { padding-top: 0.2rem; color: var(--amber); font: 600 0.75rem 'IBM Plex Mono', monospace; }
.timeline-marker { position: relative; }
.timeline-marker::before { content: ''; position: absolute; top: 0.25rem; left: 6px; width: 0.85rem; height: 0.85rem; border: 2px solid var(--teal); background: var(--ink-0); border-radius: 50%; box-shadow: 0 0 0 4px rgba(98, 203, 189, 0.15); transition: box-shadow .3s ease, border-color .3s ease, transform .3s ease; }
.timeline-marker::after { content: ''; position: absolute; top: 1.3rem; left: 12px; bottom: -1px; width: 1px; background: var(--line); }
.timeline-item:last-child .timeline-marker::after { display: none; }
.timeline-item-featured .timeline-marker::before { border-color: var(--amber); box-shadow: 0 0 0 5px rgba(231,184,102,.12), 0 0 18px rgba(231,184,102,.22); }
.timeline-item-featured:hover .timeline-marker::before { transform: scale(1.12); box-shadow: 0 0 0 6px rgba(231,184,102,.15), 0 0 24px rgba(231,184,102,.32); }
.timeline-content { position: relative; }
.timeline-item-featured .timeline-content { padding: 1.5rem 1.6rem 1.6rem; border: 1px solid rgba(231,184,102,.28); border-radius: 10px; background: linear-gradient(135deg, rgba(231,184,102,.055), rgba(98,203,189,.035) 58%, rgba(7,17,26,.72)); box-shadow: 0 16px 38px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.025); overflow: hidden; transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease; }
.timeline-item-featured .timeline-content::before { content: ''; position: absolute; top: 0; left: 0; width: 34%; height: 2px; background: linear-gradient(90deg, var(--amber), transparent); }
.timeline-item-featured .timeline-content:hover { transform: translateY(-4px); border-color: rgba(231,184,102,.52); box-shadow: 0 20px 46px rgba(0,0,0,.25), 0 0 28px rgba(231,184,102,.06); }
.timeline-current-badge { display: inline-flex; align-items: center; gap: .45rem; margin-bottom: .8rem; padding: .34rem .58rem; border: 1px solid rgba(16,185,129,.3); border-radius: 999px; color: #7de2bd; background: rgba(16,185,129,.07); font: 700 .6rem 'IBM Plex Mono', monospace; letter-spacing: .09em; }
.timeline-status-dot { width: .42rem; height: .42rem; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,.12), 0 0 10px rgba(16,185,129,.35); animation: pulse 2s infinite; }
.timeline-type { color: var(--text-low); font: 0.68rem 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: 0.08em; }
.timeline-content h3 { margin-top: 0.4rem; font-size: 1.25rem; color: var(--text-hi); }
.timeline-item-featured .timeline-content h3 { font-size: clamp(1.35rem, 2vw, 1.65rem); max-width: 28ch; }
.timeline-org { margin-top: 0.2rem; color: var(--amber); font-size: 0.92rem; font-weight: 600; }
.timeline-focus { margin-top: 1rem; color: var(--text-mid); font-size: .83rem; line-height: 1.6; }
.timeline-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
.timeline-tags span { padding: .34rem .52rem; border: 1px solid rgba(98,203,189,.22); border-radius: 4px; color: var(--teal); background: rgba(98,203,189,.045); font: 600 .62rem 'IBM Plex Mono', monospace; }
.timeline-content ul { margin-top: 1rem; display: grid; gap: 0.5rem; color: var(--text-mid); font-size: 0.88rem; line-height: 1.6; }
.timeline-content li { list-style: none; }
.timeline-content li::before { content: '—'; color: var(--teal); margin-right: 0.55rem; font-weight: 700; }
.skills-section { background: rgba(11, 23, 34, 0.88); }
.skills-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-top: 1.4rem; }
.skills-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 3.5rem; border-top: 1px solid var(--line); }
.skill-group { padding: 1.75rem 1.75rem 1.75rem 0; min-height: 220px; border-right: 1px solid var(--line); }
.skill-group:not(:first-child) { padding-left: 1.75rem; }
.skill-group:last-child { border-right: 0; }
.skill-group > span { color: var(--teal); font: 600 0.72rem 'IBM Plex Mono', monospace; }
.skill-group h3 { margin: 0.9rem 0 1.1rem; color: var(--text-hi); font-size: 1.05rem; font-weight: 600; }
.skill-group li { color: var(--text-mid); font-size: 0.88rem; line-height: 1.9; list-style: none; }
.credentials-section { background: #09151e; }
.credentials-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 8vw, 8rem); }
.credential-title { margin-top: 1.3rem; font-size: clamp(1.8rem, 3.2vw, 2.7rem); line-height: 1.08; }
.credential-program { color: var(--amber); margin-top: 1.1rem; font-size: 1.05rem; font-weight: 500; }
.credential-date { color: var(--text-low); font: 0.72rem 'IBM Plex Mono', monospace; margin-top: 0.45rem; }
.school-history { margin-top: 2rem; border-top: 1px solid var(--line); }
.school-history p { padding: 1rem 0; border-bottom: 1px solid var(--line-soft); display: grid; gap: 0.35rem; }
.school-history b { color: var(--text-hi); font-size: 0.88rem; }
.school-history span { color: var(--text-low); font-size: 0.75rem; }
.achievement { margin-top: 1.8rem; padding: 1.25rem; border-left: 3px solid var(--teal); background: rgba(98, 203, 189, 0.06); border-radius: 0 8px 8px 0; }
.achievement span { color: var(--teal); font: 600 0.65rem 'IBM Plex Mono', monospace; letter-spacing: 0.1em; }
.cert-list { margin-top: 1.6rem; border-top: 1px solid var(--line); }
.cert-list li { padding: 1.2rem 0; display: grid; grid-template-columns: 2.2rem 1fr; gap: 0.85rem; border-bottom: 1px solid var(--line-soft); }
.cert-list span { color: var(--teal); font: 600 0.72rem 'IBM Plex Mono', monospace; }
.cert-list h3 { color: var(--text-hi); font-size: 0.96rem; font-weight: 600; }
.cert-list p { color: var(--text-low); font-size: 0.82rem; margin-top: 0.35rem; }
.contact-section { padding: 0 0 clamp(4rem, 8vw, 7rem); background: #09151e; }
.contact-card { background: linear-gradient(120deg, #13313a, #102331); padding: clamp(2rem, 5vw, 4rem); display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; border: 1px solid #315765; border-radius: 12px; }
.contact-card h2 { margin-top: 1.4rem; max-width: 12ch; font-size: clamp(2.3rem, 4vw, 4.1rem); line-height: 0.98; }
.contact-card > div > p:not(.eyebrow) { margin-top: 1.3rem; max-width: 50ch; color: var(--text-mid); line-height: 1.65; font-size: 1rem; }
.contact-links { display: grid; align-content: center; }
.contact-links a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid rgba(242, 246, 246, 0.17); color: var(--text-hi); font-size: 0.98rem; transition: color 0.2s ease, border-color 0.2s ease; }
.contact-links a:hover { color: var(--amber); border-color: var(--amber); }
.contact-links span { color: var(--amber); font-family: 'IBM Plex Mono', monospace; font-size: 0.82rem; }
@media (max-width: 960px) {
  .hero-content { grid-template-columns: 1fr; gap: 3rem; padding-top: 5rem; }
  .portrait-container { justify-content: center; }
  .portrait-wrap { width: 220px; }
  .portrait-frame { width: 220px; height: 220px; }
  .about-grid, .credentials-grid, .contact-card { grid-template-columns: 1fr; }
  .project-card, .project-card-featured { grid-column: span 6; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .skill-group:nth-child(2) { border-right: 0; }
  .skill-group:nth-child(n+3) { border-top: 1px solid var(--line); }
  .skill-group:nth-child(3) { padding-left: 0; }
  .section-head { align-items: flex-start; flex-direction: column; gap: 1rem; }
}
@media (max-width: 680px) {
  .hero-copy h1 { font-size: clamp(2.5rem, 12vw, 3.8rem); }
  .portrait-wrap { width: 165px; }
  .portrait-frame { width: 165px; height: 165px; border-width: 3px; }
  .hero-actions { flex-direction: column; width: 100%; }
  .hero-actions .button { width: 100%; justify-content: center; }
  .project-grid { grid-template-columns: 1fr; }
  .project-card, .project-card-featured { grid-column: 1; }
  .project-card-featured .project-image { height: 250px; }
  .project-card-rc-aircraft .project-image { height: 260px; }
  .project-category { margin: 0.75rem 1rem 0; font-size: 0.6rem; }
  .timeline-item { grid-template-columns: 24px 1fr; gap: 0.75rem 1rem; padding-bottom: 2.2rem; }
  .timeline-date { grid-column: 2; padding-top: 0; font-size: 0.72rem; }
  .timeline-marker { grid-column: 1; grid-row: 1 / span 3; }
  .timeline-marker::after { left: 10px; }
  .timeline-marker::before { left: 4px; }
  .timeline-content { grid-column: 2; }
  .timeline-item-featured .timeline-content { padding: 1.15rem 1rem 1.2rem; }
  .timeline-item-featured .timeline-content h3 { font-size: 1.15rem; }
  .timeline-tags { gap: .35rem; }
  .timeline-tags span { font-size: .58rem; padding: .3rem .45rem; }
  .timeline-content h3 { font-size: 1.1rem; }
  .skills-grid { grid-template-columns: 1fr; }
  .skill-group, .skill-group:not(:first-child) { padding: 1.5rem 0; border-right: 0; border-top: 1px solid var(--line); }
  .skill-group:first-child { border-top: 0; }
  .contact-card { gap: 2rem; padding: 1.75rem 1.25rem; }
  .contact-card h2 { font-size: 2.4rem; }
  .contact-links a { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
  .contact-links span { font-size: 0.75rem; }
}

.resume-button { position: relative; overflow: hidden; isolation: isolate; border-color: rgba(231,184,102,.55); background: linear-gradient(135deg, rgba(231,184,102,.14), rgba(98,203,189,.08)); box-shadow: 0 0 0 1px rgba(231,184,102,.05), 0 8px 24px rgba(0,0,0,.18); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
.resume-button::before { content: ''; position: absolute; inset: 0; transform: translateX(-110%); background: linear-gradient(100deg, transparent, rgba(255,255,255,.18), transparent); transition: transform .55s ease; z-index: -1; }
.resume-button:hover { transform: translateY(-3px); border-color: var(--amber); box-shadow: 0 10px 28px rgba(231,184,102,.16); }
.resume-button:hover::before { transform: translateX(110%); }
.resume-button span { display: inline-block; transition: transform .25s ease; }
.resume-button:hover span { transform: translateY(3px); }
@media (max-width: 680px) { .resume-button { width: 100%; justify-content: center; } }
.resume-button{color:#07131a!important;background:#f0bd64!important;border:1px solid #ffe8b0!important;font-weight:800!important;box-shadow:0 0 18px rgba(240,189,100,.38),0 8px 24px rgba(0,0,0,.2)!important;position:relative;overflow:hidden;animation:resumeGlow 2.4s ease-in-out infinite}.resume-button:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent,rgba(255,255,255,.5),transparent);transform:translateX(-120%);animation:resumeShine 3s ease-in-out infinite}.resume-button:hover{color:#07131a!important;transform:translateY(-3px);box-shadow:0 0 30px rgba(240,189,100,.62),0 12px 30px rgba(0,0,0,.28)!important}.resume-icon{display:inline-block;font-weight:900}.resume-button:hover .resume-icon{transform:translateY(3px)}@keyframes resumeGlow{0%,100%{box-shadow:0 0 18px rgba(240,189,100,.3),0 8px 24px rgba(0,0,0,.2)}50%{box-shadow:0 0 32px rgba(240,189,100,.62),0 10px 28px rgba(0,0,0,.25)}}@keyframes resumeShine{0%,55%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}@media(max-width:680px){.resume-button{width:100%;justify-content:center}}</style>