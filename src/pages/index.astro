---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';
import { skillCategories } from '../data/skills';

const base = import.meta.env.BASE_URL;

const experience = [
  { date: 'Feb 2026 — Present', role: 'Graduate Engineer Trainee (GET) — Sourcing Department', org: 'AMPO Valves India', type: 'Full-time · Coimbatore, India', featured: true, tags: ['SAP', 'Shipment Documentation', 'Spain Coordination', 'Quality & Compliance', 'SolidWorks · ANSYS'], points: ['Manage sourcing documentation in SAP, including delivery invoices for sea and air shipments.', 'Coordinate with the Spain-based team to track shipments and support accurate documentation.', 'Generate and update Material Identification Numbers (MIN) and QR codes for shipment tracking and verification.', 'Handle quality and compliance documentation: Heat Numbers, Material Test Certificates (MTC), and Radiographic Testing records.', 'Support SolidWorks design work and ANSYS simulation tasks.'] },
  { date: 'Jan 2024 — Apr 2026', role: 'Blender Animation · 3D Artist · Motion Graphics', org: 'Pixar Prince Animation Studio', type: 'Freelance · Coimbatore, India', points: ['Developed 3D animation and motion graphics in Blender.', 'Created CGI, visual effects, simulation, and cinematic visual work with a focus on timing, composition, and visual storytelling.'] },
  { date: 'July 2025', role: 'Electric Vehicle Battery & Motor Design', org: 'Dassault Systèmes', type: 'Internship · Coimbatore, India', points: ['Worked on EV battery-pack and motor-assembly design.', 'Applied CAD modeling to layout, feasibility, structural reliability, safety considerations, and lightweight integration.'] },
  { date: 'May 2025', role: 'RC Plane Design & Development', org: 'Jet Aerospace', type: 'Internship · Kerala, India', points: ['Contributed to aircraft concept development, aerodynamic design, CAD modeling, and lightweight structural design.', 'Worked on aircraft assembly, propulsion, ESC, servo, RC-control integration, and flight testing.'] },
];
const skillGroups = [
  { number: '01', label: 'Engineering analysis', items: ['ANSYS', 'CFD', 'Structural analysis', 'Aeronautical systems'] },
  { number: '02', label: 'Design & CAD', items: ['SolidWorks', 'CATIA', '3D printing', 'Design for additive manufacturing'] },
  { number: '03', label: 'Visualization', items: ['Unreal Engine 5.4', 'Blender', 'Nuke', 'After Effects'] },
  { number: '04', label: 'Operations', items: ['SAP', 'Shipment documentation', 'MTC / Heat Numbers / RT', 'International logistics'] },
];
const projectMedia: Record<string, { type: 'image' | 'video'; src: string }> = {
  'abhyaas-uav-s-duct': { type: 'image', src: `${base}media/cover.jpeg` },
  'rc-aircraft': { type: 'image', src: `${base}media/projects/rc-aircraft/1.jpeg` },
  'pandora-unreal-environment': { type: 'video', src: `${base}media/projects/pandora/environment-art.mp4` },
  'the-horizon': { type: 'video', src: `${base}media/projects/pandora/the-horizon.mp4` },
  'ancient-stillness': { type: 'video', src: `${base}media/projects/pandora/ancient-stillness.mp4` },
  'contra-rotating-vawt': { type: 'image', src: `${base}media/projects/vawt.jpeg` },
  'drone-additive-manufacturing': { type: 'image', src: `${base}media/projects/drone/3.jpeg` },
  'ev-battery-motor-design': { type: 'image', src: `${base}media/projects/ev-design/1.jpeg` },
};
const certifications = [['ANSYS Virtual Intern in Fluid Dynamics', 'Computational fluid dynamics & aerodynamic analysis'], ['Drone Design & Structural Analysis', 'UAV structural evaluation, payload & airframe sizing'], ['Electric Vehicle Battery & Motor', 'Dassault Systèmes — EV powertrain & structural safety'], ['Blender Digital Sculpting', '3D CGI, photorealistic lighting & animation'], ['RC Plane Design & Development', 'Jet Aerospace — flight aerodynamics & RC integration']];
---
<Layout title="Portfolio" description="Gowtham A — Aeronautical Engineering graduate working across design, simulation, real-time visualization, and sourcing operations.">
  <div class="honors-popup-backdrop" id="honors-popup" role="presentation">
    <aside class="honors-popup" role="dialog" aria-modal="true" aria-labelledby="honors-popup-title">
      <button class="honors-popup-close" id="honors-popup-close" type="button" aria-label="Close athletic honors">×</button>
      <div class="honors-popup-layout">
        <div class="honors-popup-photo">
          <img src={`${base}media/profile-professional.jpg`} alt="Gowtham A" />
        </div>
        <div class="honors-popup-content">
          <div class="honors-popup-badge"><span class="honors-medal">★</span><span>ATHLETIC HONORS</span></div>
          <p class="honors-popup-kicker">Record Holder</p>
          <h2 id="honors-popup-title">Asian Record Holder</h2>
          <p class="honors-popup-sport">Roller Skating</p>
          <div class="honors-popup-line"></div>
          <p class="honors-popup-copy">A lifetime milestone reflecting dedication, discipline, endurance, and competitive resilience at the Asian continental level.</p>
          <div class="honors-popup-footer"><span>ASIAN RECORD</span><span aria-hidden="true">✦</span><span>PROUD MILESTONE</span></div>
          <a href={`${base}media/Resume/Gowtham_A_Resume.pdf`} class="honors-resume-button" download aria-label="Download Gowtham A's latest resume"><span class="honors-resume-icon" aria-hidden="true">↓</span><span>Download Gowtham's Latest Resume</span></a>
        </div>
      </div>
    </aside>
  </div>

  <section class="hero"><div class="hero-grid"></div><div class="hero-orbit"></div><div class="shell hero-content"><div class="hero-copy reveal"><p class="eyebrow">Gowtham A · Coimbatore, India</p><h1>Engineering <em>systems</em>.<br />Visualizing what’s next.</h1><p class="hero-intro">Aeronautical Engineering graduate and Graduate Engineer Trainee in Sourcing. I work across design engineering, simulation, real-time visualization, and global operations.</p><div class="hero-actions"><a href="#projects" class="button">Explore selected work <span aria-hidden="true">↓</span></a><a href="#contact" class="button button-secondary">Get in touch</a><a href={`${base}media/Resume/Gowtham_A_Resume.pdf`} class="button resume-button" download><span class="resume-icon" aria-hidden="true">↓</span><span>Download Resume</span></a><a href="https://www.linkedin.com/in/gowtham1745/" class="social-button" target="_blank" rel="noreferrer" aria-label="Open Gowtham A on LinkedIn"><span class="social-icon">in</span><span>LinkedIn</span><span class="social-arrow">↗</span></a><a href="https://github.com/Gowtham1745" class="social-button social-button-github" target="_blank" rel="noreferrer" aria-label="Open Gowtham A on GitHub"><span class="social-icon">◉</span><span>GitHub</span><span class="social-arrow">↗</span></a></div><div class="hero-meta"><span><b>Based in</b> Tamil Nadu, India</span><span><b>Currently</b> AMPO Valves India</span></div></div><div class="portrait-container reveal"><div class="portrait-wrap"><div class="portrait-frame"><img src={`${base}media/profile-professional.jpg`} alt="Portrait of Gowtham A" class="portrait" loading="eager" /><div class="corner corner-tl"></div><div class="corner corner-br"></div></div><div class="portrait-caption"><span class="pulse"></span> Gowtham A · available for the next challenge</div></div></div></div></section>
  <section id="about" class="section about-section"><div class="shell about-grid"><div><p class="eyebrow">About</p><h2 class="section-title mt-5">A cross-disciplinary engineering practice.</h2></div><div class="about-copy"><p>I work at the intersection of design engineering, real-time visualization, and global operations. At AMPO Valves India, my day-to-day includes SAP-based shipment documentation, customs-clearance support, coordination with Spain-based teams, quality and compliance records, and CAD / simulation support.</p><p>My B.E. in Aeronautical Engineering at Kumaraguru College of Technology culminated in an ABHYAAS UAV S-duct intake project: CFD analysis, design optimization, 3D printing, and wind tunnel validation. Alongside engineering, I’ve developed a CGI and real-time visualization practice through Blender, Unreal Engine, and After Effects.</p><a href="#experience" class="text-link">Read the experience timeline <span>→</span></a></div></div></section>
  <section id="projects" class="section projects-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title mt-5">Projects built across physical and digital systems.</h2></div><p class="section-note">Every project image is matched to the work shown. Where supporting media is not yet available, the card uses a technical placeholder instead.</p></div><div class="project-grid">{projects.map((project, index) => { const media = projectMedia[project.slug]; return (<article class:list={['project-card', `project-card-${project.slug}`, { 'project-card-featured': index === 0 || index === 2 }]}><div class="project-category">{project.category}</div><div class="project-image">{media?.type === 'video' ? <video src={media.src} muted autoplay loop playsinline preload="metadata" aria-label={`${project.title} video preview`}></video> : media ? <img src={media.src} alt="" loading={index < 3 ? 'eager' : 'lazy'} /> : <div class="project-placeholder"><span>PROJECT<br />MEDIA</span><i></i></div>}</div><div class="project-body"><div class="project-number">0{index + 1} / {project.year}</div><h3>{project.title}</h3><p>{project.blurb}</p><div class="project-footer"><div class="project-tools">{project.tools.slice(0, 3).map((tool) => <span>{tool}</span>)}</div>{project.href ? <a href={`${base}${project.href.replace(/^\//, "")}`} aria-label={`Read ${project.title} project`}>View <span>↗</span></a> : <span class="project-status">Project overview</span>}</div></div></article>); })}</div></div></section>
  <section id="experience" class="section timeline-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Experience</p><h2 class="section-title mt-5">Work shaped by detail.</h2></div><p class="section-note">A clear view of the roles, responsibilities, and engineering support behind my current work.</p></div><div class="timeline">{experience.map((job) => (<article class:list={['timeline-item', { 'timeline-item-featured': job.featured }]}><div class="timeline-date">{job.date}</div><div class="timeline-marker"></div><div class="timeline-content">{job.featured && <div class="timeline-current-badge"><span class="timeline-status-dot"></span> CURRENT ROLE</div>}<p class="timeline-type">{job.type}</p><h3>{job.role}</h3><p class="timeline-org">{job.org}</p>{job.featured && <div class="timeline-tags">{job.tags.map((tag) => <span>{tag}</span>)}</div>}{job.featured && <p class="timeline-focus">Working across sourcing operations, international coordination, quality documentation, and engineering support.</p>}<ul>{job.points.map((point) => <li>{point}</li>)}</ul></div></article>))}</div></div></section>
  <section id="skills" class="section skills-section">
    <div class="shell">
      <div class="section-head skills-section-head">
        <div>
          <p class="eyebrow">Skills</p>
          <h2 class="section-title mt-5">What I use — and how I use it.</h2>
        </div>
        <p class="section-note">A practical view of the tools and technical capabilities behind my engineering, simulation, visualization, and sourcing work. The descriptions are grounded in my LinkedIn skills and project experience.</p>
      </div>
      <div class="skills-summary">
        <div class="skills-summary-item"><span class="skills-summary-number">25+</span><span>LinkedIn-listed skills</span></div>
        <div class="skills-summary-item"><span class="skills-summary-number">05</span><span>Core capability areas</span></div>
        <div class="skills-summary-item"><span class="skills-summary-number">01</span><span>Cross-disciplinary toolkit</span></div>
      </div>
      <div class="skills-detail-grid">
        {skillCategories.map((group, groupIndex) => (
          <article class="skill-detail-card" style={`--skill-delay: ${groupIndex * 70}ms`}>
            <div class="skill-detail-header">
              <div>
                <span class="skill-detail-number">0{groupIndex + 1}</span>
                <h3>{group.category}</h3>
              </div>
              <span class="skill-detail-arrow" aria-hidden="true">↗</span>
            </div>
            <p class="skill-detail-tagline">{group.tagline}</p>
            <div class="skill-items">
              {group.skills.map((skill) => (
                <div class="skill-item">
                  <div class="skill-item-top">
                    <h4>{skill.name}</h4>
                    <span class:list={['skill-level', `skill-level-${skill.level.toLowerCase()}`]}>{skill.level}</span>
                  </div>
                  {skill.note && <p>{skill.note}</p>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      <div class="skills-language-strip">
        <span class="skills-language-label">Programming</span>
        <span>C</span><span>C++</span><span>Python</span>
        <span class="skills-language-label skills-language-label-spaced">Technical focus</span>
        <span>CAD / CAE</span><span>CFD</span><span>Additive Manufacturing</span><span>Supply Chain &amp; Sourcing</span>
      </div>
    </div>
  </section>
<style>
.skills-section-head{align-items:end}.skills-section-head .section-title{max-width:14ch}
.skills-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:2.5rem;border:1px solid var(--line);background:var(--line)}
.skills-summary-item{min-height:92px;display:flex;flex-direction:column;justify-content:center;gap:.25rem;padding:1.1rem 1.25rem;background:linear-gradient(145deg,rgba(16,35,49,.82),rgba(7,17,26,.94));color:var(--text-low);font:500 .66rem 'IBM Plex Mono',monospace;letter-spacing:.04em;text-transform:uppercase}
.skills-summary-number{color:var(--amber);font:600 1.55rem 'Space Grotesk',sans-serif;letter-spacing:-.03em}
.skills-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}
.skill-detail-card{position:relative;overflow:hidden;padding:1.45rem;border:1px solid var(--line);background:radial-gradient(circle at 100% 0%,rgba(98,203,189,.08),transparent 32%),linear-gradient(145deg,rgba(16,35,49,.72),rgba(7,17,26,.95));transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease;animation:skill-card-in .65s cubic-bezier(.16,1,.3,1) both;animation-delay:var(--skill-delay)}
.skill-detail-card::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,transparent 20%,rgba(255,255,255,.035) 48%,transparent 72%);transform:translateX(-120%);transition:transform .8s ease}
.skill-detail-card:hover{transform:translateY(-4px);border-color:rgba(231,184,102,.48);box-shadow:0 18px 42px rgba(0,0,0,.24),0 0 26px rgba(98,203,189,.05)}
.skill-detail-card:hover::after{transform:translateX(120%)}
.skill-detail-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.skill-detail-number{display:block;margin-bottom:.45rem;color:var(--amber);font:500 .62rem 'IBM Plex Mono',monospace;letter-spacing:.12em}.skill-detail-header h3{color:var(--text-hi);font-size:1.18rem;line-height:1.15}.skill-detail-arrow{width:2rem;height:2rem;flex:0 0 2rem;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;color:var(--teal);font-size:.82rem;transition:transform .3s ease,border-color .3s ease}.skill-detail-card:hover .skill-detail-arrow{transform:rotate(45deg);border-color:var(--teal)}
.skill-detail-tagline{margin-top:.8rem;max-width:58ch;color:var(--text-low);font-size:.78rem;line-height:1.55}.skill-items{display:grid;gap:.55rem;margin-top:1.15rem}.skill-item{padding:.82rem .85rem;border:1px solid rgba(39,65,80,.78);background:rgba(7,17,26,.44);transition:background .25s ease,border-color .25s ease,transform .25s ease}.skill-item:hover{background:rgba(16,35,49,.72);border-color:rgba(98,203,189,.28);transform:translateX(3px)}.skill-item-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem}.skill-item h4{color:var(--text-hi);font-size:.83rem;line-height:1.3;font-weight:600}.skill-item p{margin-top:.35rem;color:var(--text-low);font-size:.69rem;line-height:1.55}.skill-level{flex:0 0 auto;padding:.22rem .42rem;border:1px solid rgba(231,184,102,.28);color:var(--amber);font:500 .54rem 'IBM Plex Mono',monospace;letter-spacing:.04em;text-transform:uppercase}.skill-level-advanced{color:var(--teal);border-color:rgba(98,203,189,.3)}.skill-level-proficient{color:var(--text-mid);border-color:rgba(175,193,201,.24)}
.skills-language-strip{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:1rem;padding:1rem 1.15rem;border:1px solid var(--line);background:rgba(7,17,26,.6);color:var(--text-mid);font:500 .63rem 'IBM Plex Mono',monospace}.skills-language-strip>span:not(.skills-language-label){padding:.3rem .48rem;border:1px solid var(--line);color:var(--text-hi)}.skills-language-label{margin-right:.25rem;color:var(--amber);text-transform:uppercase;letter-spacing:.1em}.skills-language-label-spaced{margin-left:.75rem}
@keyframes skill-card-in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){.skills-summary{grid-template-columns:1fr}.skills-summary-item{min-height:72px}.skills-detail-grid{grid-template-columns:1fr}.skills-section-head{align-items:start}.skills-language-label-spaced{margin-left:0;flex-basis:100%;margin-top:.35rem}}@media(prefers-reduced-motion:reduce){.skill-detail-card{animation:none}.skill-detail-card,.skill-item,.skill-detail-arrow{transition:none}}
</style>

  <section id="achievements" class="section achievements-section">
    <div class="shell">
      <div class="section-head achievements-head">
        <div>
          <p class="eyebrow">Achievements</p>
          <h2 class="section-title mt-5">A milestone worth putting front and centre.</h2>
        </div>
        <p class="section-note">A dedicated highlight for one of my strongest recent achievements — the NVIDIA AI PC Day Award received with my team for CGI and VFX excellence.</p>
      </div>

      <article class="achievement-feature">
        <div class="achievement-hero">
          <div class="achievement-hero-image">
            <img src={`${base}media/Nvidia%20Award/1.jpeg`} alt="NVIDIA AI PC Day — Overall Champion achievement" loading="lazy" />
            <div class="achievement-image-overlay"><span>OVERALL CHAMPION</span><span>01 / 05</span></div>
          </div>
          <div class="achievement-hero-copy">
            <div class="achievement-kicker"><span class="achievement-star">★</span><span>NVIDIA · AI PC DAY</span></div>
            <h3>NVIDIA AI PC Day — Overall Champion</h3>
            <p class="achievement-lead">Industry-Grade CGI &amp; Simulation powered by NVIDIA RTX</p>
            <p class="achievement-description">A top-tier team achievement recognising an end-to-end production pipeline accelerated by NVIDIA RTX, with cinema-quality visuals and a professional-level rendering workflow.</p>
            <div class="achievement-tags">
              <span>OVERALL CHAMPION</span>
              <span>NVIDIA RTX</span>
              <span>TEAM ACHIEVEMENT</span>
            </div>
          </div>
        </div>

        <div class="achievement-highlights">
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">TOP-TIER ACHIEVEMENT</span>
            <strong>End-to-End Production Pipeline</strong>
            <p>Accelerated by NVIDIA RTX.</p>
          </div>
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">SIGNATURE ACHIEVEMENT</span>
            <strong>Cinema-Quality Visuals</strong>
            <p>Delivered using NVIDIA RTX AI.</p>
          </div>
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">ELITE ACHIEVEMENT</span>
            <strong>Professional-Level Rendering Workflow</strong>
            <p>Validated on NVIDIA RTX.</p>
          </div>
        </div>

        <div class="achievement-gallery" aria-label="NVIDIA AI PC Day achievement photo gallery">
          {[
            ['2.jpeg', 'Award moment · 02 / 05'],
            ['3.jpeg', 'Team / event moment · 03 / 05'],
            ['4.jpeg', 'Achievement highlight · 04 / 05'],
            ['5.jpeg', 'Award memory · 05 / 05'],
          ].map(([file, label]) => (
            <a class="achievement-gallery-item" href={`${base}media/Nvidia%20Award/${file}`} target="_blank" rel="noreferrer" aria-label={`Open ${label}`}>
              <img src={`${base}media/Nvidia%20Award/${file}`} alt={`NVIDIA AI PC Day — ${label}`} loading="lazy" />
              <span>{label} ↗</span>
            </a>
          ))}
        </div>

        <div class="achievement-footer">
          <div><span class="achievement-footer-label">SIGNATURE IMPACT</span><strong>Creative excellence, technical capability, and team execution.</strong></div>
          <a href="#projects" class="text-link">See the work behind the craft <span>→</span></a>
        </div>
      </article>
    </div>
  </section>

  <style>
    .achievements-section{overflow:hidden}
    .achievements-head{align-items:end}
    .achievement-feature{margin-top:2.5rem;border:1px solid var(--line);background:linear-gradient(145deg,rgba(16,35,49,.9),rgba(7,17,26,.98));box-shadow:0 28px 70px rgba(0,0,0,.22)}
    .achievement-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);min-height:430px}
    .achievement-hero-image{position:relative;min-height:430px;overflow:hidden;background:#08151e}
    .achievement-hero-image::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,rgba(7,17,26,.82) 100%),linear-gradient(0deg,rgba(7,17,26,.55),transparent 45%);pointer-events:none}
    .achievement-hero-image img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .8s cubic-bezier(.16,1,.3,1)}
    .achievement-feature:hover .achievement-hero-image img{transform:scale(1.025)}
    .achievement-image-overlay{position:absolute;z-index:2;left:1.15rem;right:1.15rem;bottom:1.1rem;display:flex;justify-content:space-between;gap:1rem;color:rgba(242,246,246,.88);font:500 .59rem 'IBM Plex Mono',monospace;letter-spacing:.1em;text-transform:uppercase}
    .achievement-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.6rem,4vw,3.4rem)}
    .achievement-kicker{display:flex;align-items:center;gap:.55rem;color:var(--amber);font:500 .62rem 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase}
    .achievement-star{display:grid;place-items:center;width:1.75rem;height:1.75rem;border:1px solid rgba(231,184,102,.45);border-radius:50%;box-shadow:0 0 18px rgba(231,184,102,.12)}
    .achievement-hero-copy h3{margin-top:1rem;color:var(--text-hi);font-size:clamp(2rem,4vw,3.5rem);line-height:.98;max-width:9ch}
    .achievement-lead{margin-top:.85rem;color:var(--teal);font:600 .9rem 'IBM Plex Mono',monospace;letter-spacing:.06em;text-transform:uppercase}
    .achievement-description{margin-top:1.1rem;max-width:48ch;color:var(--text-mid);font-size:.86rem;line-height:1.7}
    .achievement-tags{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.4rem}
    .achievement-tags span{padding:.38rem .5rem;border:1px solid var(--line);color:var(--text-low);font:500 .55rem 'IBM Plex Mono',monospace;letter-spacing:.06em}
    .achievement-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border-top:1px solid var(--line)}
    .achievement-highlight-card{padding:1.25rem 1.35rem;background:rgba(7,17,26,.72);min-height:128px;display:flex;flex-direction:column;justify-content:center;transition:background .25s ease,transform .25s ease}
    .achievement-highlight-card:hover{background:rgba(16,35,49,.92);transform:translateY(-2px)}
    .achievement-highlight-label{color:var(--amber);font:600 .55rem 'IBM Plex Mono',monospace;letter-spacing:.1em;text-transform:uppercase}
    .achievement-highlight-card strong{margin-top:.45rem;color:var(--text-hi);font:600 .92rem 'Space Grotesk',sans-serif;line-height:1.25}
    .achievement-highlight-card p{margin-top:.35rem;color:var(--text-low);font-size:.72rem;line-height:1.45}
    .achievement-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border-top:1px solid var(--line)}
    .achievement-gallery-item{position:relative;display:block;min-height:145px;overflow:hidden;background:var(--ink-1)}
