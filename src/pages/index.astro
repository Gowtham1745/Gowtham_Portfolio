---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';
import { skillCategories } from '../data/skills';

const base = import.meta.env.BASE_URL;

const experience = [
  { date: 'Feb 2026 — Present', role: 'Graduate Engineer Trainee (GET) — Sourcing Department', org: 'AMPO Valves India', type: 'Full-time · Coimbatore, India', featured: true, tags: ['SAP', 'Shipment Documentation', 'Spain Coordination', 'Quality & Compliance', 'SolidWorks · ANSYS'], points: ['Manage sourcing documentation in SAP, including delivery invoices for sea and air shipments.', 'Coordinate with the Spain-based team to track shipments and support accurate documentation.', 'Generate and update Material Identification Numbers (MIN) and QR codes for shipment tracking and verification.', 'Handle quality and compliance documentation: Heat Numbers, Material Test Certificates (MTC), and Radiographic Testing records.', 'Support SolidWorks design work and ANSYS simulation tasks.'] },
  { date: 'Jan 2024 — Apr 2026', role: 'Blender Animation · 3D Artist · Motion Graphics', org: 'Pixar Prince Animation Studio', type: 'Freelance · Coimbatore, India', points: ['Developed 3D animation and motion graphics in Blender.', 'Created CGI, visual effects, simulation, and cinematic visual work with a focus on timing, composition, and visual storytelling.'] },
  { date: 'July 2025', role: 'Electric Vehicle Battery & Motor Design', org: 'Dassault Systèmes', type: 'Internship · Coimbatore, India', points: ['Worked on EV battery-pack and motor-assembly design.', 'Applied CAD modeling to layout, feasibility, structural reliability, safety considerations, and lightweight integration.'] },
  { date: 'May 2025', role: 'RC Plane Design & Development', org: 'Jet Aerospace', type: 'Internship · Kerala, India', points: ['Contributed to aircraft concept development, aerodynamic design, CAD modeling, and lightweight structural design.', 'Worked on aircraft assembly, propulsion, ESC, servo, RC-control integration, and flight testing.'] },
];
const skillGroups = [
  { number: '01', label: 'Engineering analysis', items: ['ANSYS', 'CFD', 'Structural analysis', 'Aeronautical systems'] },
  { number: '02', label: 'Design & CAD', items: ['SolidWorks', 'CATIA', '3D printing', 'Design for additive manufacturing'] },
  { number: '03', label: 'Visualization', items: ['Unreal Engine 5.4', 'Blender', 'Nuke', 'After Effects'] },
  { number: '04', label: 'Operations', items: ['SAP', 'Shipment documentation', 'MTC / Heat Numbers / RT', 'International logistics'] },
];
const projectMedia: Record<string, { type: 'image' | 'video'; src: string }> = {
  'abhyaas-uav-s-duct': { type: 'image', src: `${base}media/cover.jpeg` },
  'rc-aircraft': { type: 'image', src: `${base}media/projects/rc-aircraft/1.jpeg` },
  'pandora-unreal-environment': { type: 'video', src: `${base}media/projects/pandora/environment-art.mp4` },
  'the-horizon': { type: 'video', src: `${base}media/projects/pandora/the-horizon.mp4` },
  'ancient-stillness': { type: 'video', src: `${base}media/projects/pandora/ancient-stillness.mp4` },
  'contra-rotating-vawt': { type: 'image', src: `${base}media/projects/vawt.jpeg` },
  'drone-additive-manufacturing': { type: 'image', src: `${base}media/projects/drone/3.jpeg` },
  'ev-battery-motor-design': { type: 'image', src: `${base}media/projects/ev-design/1.jpeg` },
};
const featuredHighlights = [
  { title: 'NVIDIA AI PC Day — Overall Champion', category: 'Achievement · NVIDIA RTX', year: '2026', image: `${base}media/Nvidia%20Award/1.jpeg`, alt: 'NVIDIA AI PC Day Overall Champion achievement', blurb: 'Industry-grade CGI and simulation powered by NVIDIA RTX, recognised through an end-to-end production pipeline, cinema-quality visuals, and professional-level rendering workflow.', href: '#achievements', action: 'View achievement', featured: true },
  { title: 'Asian Record Holder · Roller Skating', category: 'Achievement · Athletic Honor', year: 'Lifetime milestone', image: `${base}media/sports-record.jpeg`, alt: 'Asian Record Holder achievement in roller skating', blurb: 'A defining athletic achievement representing dedication, discipline, endurance, and competitive resilience at the Asian continental level.', href: '#education', action: 'View achievement', featured: false },
  { title: 'RC Aircraft — Jet Aerospace', category: 'Project · Aerospace Systems', year: '2025', image: `${base}media/projects/rc-aircraft/1.jpeg`, alt: 'RC aircraft design and development project', blurb: 'A fully functional RC aircraft developed from aerodynamic concept and CAD through propulsion, control integration, assembly, and flight testing.', href: '/projects/rc-aircraft', action: 'View project', featured: false },
];
const secondaryProjects = projects.filter((project) => project.slug !== 'rc-aircraft');
const certifications = [['ANSYS Virtual Intern in Fluid Dynamics', 'Computational fluid dynamics & aerodynamic analysis'], ['Drone Design & Structural Analysis', 'UAV structural evaluation, payload & airframe sizing'], ['Electric Vehicle Battery & Motor', 'Dassault Systèmes — EV powertrain & structural safety'], ['Blender Digital Sculpting', '3D CGI, photorealistic lighting & animation'], ['RC Plane Design & Development', 'Jet Aerospace — flight aerodynamics & RC integration']];
---
<Layout title="Gowtham A — Aeronautical Engineer | Design, Simulation & Sourcing" description="Gowtham A is an Aeronautical Engineering graduate and Graduate Engineer Trainee working across design engineering, simulation, real-time visualization, and global sourcing operations.">
    <div class="honors-popup-backdrop honors-popup-pending" id="honors-popup" role="presentation">
    <section class="honors-popup" role="dialog" aria-modal="true" aria-roledescription="carousel" aria-label="Gowtham's featured achievements">
      <button class="honors-popup-close" id="honors-popup-close" type="button" aria-label="Close achievements">×</button>
      <div class="honors-popup-topline"><span class="honors-popup-badge"><span class="honors-medal">★</span><span>SELECTED ACHIEVEMENTS</span></span><span class="honors-popup-count" id="honors-popup-count">01 / 02</span></div>
      <div class="honors-slides">
        <article class="honors-slide is-active" data-slide="0" aria-hidden="false">
          <div class="honors-slide-image"><img src={`${base}media/sports-record.jpeg`} alt="Gowtham's Asian Record Holder roller skating achievement" fetchpriority="high" /></div>
          <div class="honors-slide-content">
            <p class="honors-popup-kicker">Athletic achievement</p><h2 id="honors-popup-title">Asian Record Holder</h2><p class="honors-popup-sport">Roller Skating</p>
            <p class="honors-popup-copy">A proud milestone built through years of discipline, training, endurance, and determination.</p>
            <div class="honors-popup-footer"><span>ASIAN RECORD</span><span aria-hidden="true">✦</span><span>ATHLETIC HONOR</span></div>
          </div>
        </article>
        <article class="honors-slide" data-slide="1" aria-hidden="true" inert>
          <div class="honors-slide-image"><img src={`${base}media/Nvidia%20Award/1.jpeg`} alt="NVIDIA AI PC Day Overall Champion award" loading="lazy" decoding="async" /></div>
          <div class="honors-slide-content">
            <p class="honors-popup-kicker">Team achievement · 2026</p><h2>NVIDIA AI PC Day</h2><p class="honors-popup-sport">Overall Champion</p>
            <p class="honors-popup-copy">Recognised with my team for creative technical work and an outstanding AI PC experience.</p>
            <div class="honors-popup-footer"><span>NVIDIA</span><span aria-hidden="true">✦</span><span>OVERALL CHAMPION</span></div>
          </div>
        </article>
      </div>
      
      <a href={`${base}media/Resume/Gowtham_A_Resume.pdf`} class="honors-resume-button" download aria-label="Download Gowtham A's latest resume"><span class="honors-resume-icon" aria-hidden="true">↓</span><span>Download Resume</span></a>
    </section>
  </div>

<section class="hero"><div class="hero-grid"></div><div class="hero-orbit"></div><div class="shell hero-content"><div class="hero-copy reveal"><p class="eyebrow">Gowtham A · Coimbatore, India</p><h1>I turn ideas into <em>engineering solutions.</em></h1><p class="hero-intro">Aeronautical Engineering graduate at AMPO Valves India, working across sourcing operations, CAD design, and engineering simulation.</p><div class="hero-actions"><a href="#projects" class="button">Explore selected work <span aria-hidden="true">↓</span></a><a href="#contact" class="button button-secondary">Get in touch</a><a href={`${base}media/Resume/Gowtham_A_Resume.pdf`} class="button resume-button" download><span class="resume-icon" aria-hidden="true">↓</span><span>Download Resume</span></a></div><div class="hero-meta"><span><b>Based in</b> Tamil Nadu, India</span><span><b>Currently</b> AMPO Valves India</span></div><div class="follow-card" id="follow-card" data-base="517"><div class="follow-count"><strong id="follow-count" aria-live="polite">517</strong><span>followers</span></div><button type="button" class="button follow-button" id="follow-button" aria-pressed="false"><span id="follow-label">Follow</span></button></div></div><div class="portrait-container reveal"><div class="portrait-wrap"><div class="portrait-frame"><img src={`${base}media/profile-professional.jpg`} alt="Portrait of Gowtham A" class="portrait" loading="eager" /><div class="corner corner-tl"></div><div class="corner corner-br"></div></div><div class="portrait-caption"><span class="pulse"></span> Gowtham A · available for the next challenge</div></div></div></div></section>
  
    <section id="featured" class="section featured-section">
    <div class="shell">
      <div class="section-head featured-head">
        <div>
          <p class="eyebrow">Featured</p>
          <h2 class="section-title mt-5">Three highlights worth remembering.</h2>
        </div>
        <p class="section-note">The three strongest portfolio highlights — one major team achievement, one defining personal record, and one hands-on aerospace project.</p>
      </div>
      <div class="featured-grid">
        {featuredHighlights.map((item, index) => (
          <article class:list={['featured-card', { 'featured-card-primary': item.featured }]}>
            <a href={item.href.startsWith('#') ? item.href : `${base}${item.href.replace(/^\//, '')}`} class="featured-media-link" aria-label={item.action + ': ' + item.title}>
              <div class="featured-media">
                <img src={item.image} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                <div class="featured-media-overlay"><span>0{index + 1} / 03</span><span>{item.year}</span></div>
              </div>
            </a>
            <div class="featured-body">
              <div class="featured-meta"><span>{item.category}</span><span class="featured-index">0{index + 1}</span></div>
              <h3>{item.title}</h3>
              <p>{item.blurb}</p>
              <a class="featured-action" href={item.href.startsWith('#') ? item.href : `${base}${item.href.replace(/^\//, '')}`}>{item.action} <span>↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="section about-section"><div class="shell about-grid"><div><p class="eyebrow">About</p><h2 class="section-title mt-5">A cross-disciplinary engineering practice.</h2></div><div class="about-copy"><p>I work across design engineering, real-time visualization, and global operations. At AMPO Valves India, I support SAP shipment documentation, international coordination, quality records, and CAD/simulation work.</p><details class="section-more about-more"><summary><span class="more-label-closed">Explore my engineering background</span><span class="more-label-open">Hide background details</span></summary><div class="section-more-content"><p>My B.E. in Aeronautical Engineering at Kumaraguru College of Technology culminated in an ABHYAAS UAV S-duct intake project: CFD analysis, design optimization, 3D printing, and wind tunnel validation. Alongside engineering, I’ve developed a CGI and real-time visualization practice through Blender, Unreal Engine, and After Effects.</p><a href="#experience" class="text-link">Read the experience timeline <span>→</span></a></div></details></div></div></section>

  

  <section id="projects" class="section projects-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title mt-5">Projects built across physical and digital systems.</h2></div><p class="section-note">A focused selection of project work, with additional case studies available below.</p></div><div class="project-grid">{secondaryProjects.slice(0, 2).map((project, index) => { const media = projectMedia[project.slug]; return (<article class:list={['project-card', `project-card-${project.slug}`, { 'project-card-featured': index === 0 }]}><div class="project-category">{project.category}</div><div class="project-image">{media?.type === 'video' ? <video data-src={media.src} muted loop playsinline preload="none" aria-label={`${project.title} video preview`}></video> : media ? <img src={media.src} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /> : <div class="project-placeholder"><span>PROJECT<br />MEDIA</span><i></i></div>}</div><div class="project-body"><div class="project-number">0{index + 1} / {project.year}</div><h3>{project.title}</h3><p>{project.blurb}</p><div class="project-footer"><div class="project-tools">{project.tools.slice(0, 3).map((tool) => <span>{tool}</span>)}</div>{project.href ? <a href={`${base}${project.href.replace(/^\//, "")}`} aria-label={`Read ${project.title} project`}>View <span>↗</span></a> : <span class="project-status">Project overview</span>}</div></div></article>); })}</div><details class="section-more projects-more"><summary><span class="more-label-closed">See more projects</span><span class="more-label-open">Show fewer projects</span></summary><div class="project-grid project-grid-more">{secondaryProjects.slice(2).map((project, index) => { const media = projectMedia[project.slug]; return (<article class:list={['project-card', `project-card-${project.slug}`]}><div class="project-category">{project.category}</div><div class="project-image">{media?.type === 'video' ? <video data-src={media.src} muted loop playsinline preload="none" aria-label={`${project.title} video preview`}></video> : media ? <img src={media.src} alt="" loading="lazy" decoding="async" /> : <div class="project-placeholder"><span>PROJECT<br />MEDIA</span><i></i></div>}</div><div class="project-body"><div class="project-number">MORE · 0{index + 1}</div><h3>{project.title}</h3><p>{project.blurb}</p><div class="project-footer"><div class="project-tools">{project.tools.slice(0, 3).map((tool) => <span>{tool}</span>)}</div>{project.href ? <a href={`${base}${project.href.replace(/^\//, "")}`} aria-label={`Read ${project.title} project`}>View <span>↗</span></a> : <span class="project-status">Project overview</span>}</div></div></article>); })}</div></details></div></section>
  <section id="experience" class="section timeline-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Experience</p><h2 class="section-title mt-5">Work shaped by detail.</h2></div><p class="section-note">A clear view of the roles, responsibilities, and engineering support behind my current work.</p></div><div class="timeline">{experience.filter((job) => job.featured).map((job) => (<article class:list={["timeline-item", { "timeline-item-featured": job.featured }]}><div class="timeline-date">{job.date}</div><div class="timeline-marker"></div><div class="timeline-content">{job.featured && <div class="timeline-current-badge"><span class="timeline-status-dot"></span> CURRENT ROLE</div>}<p class="timeline-type">{job.type}</p><h3>{job.role}</h3><p class="timeline-org">{job.org}</p>{job.featured && <div class="timeline-tags">{job.tags.map((tag) => <span>{tag}</span>)}</div>}{job.featured && <p class="timeline-focus">Working across sourcing operations, international coordination, quality documentation, and engineering support.</p>}<ul>{job.points.map((point) => <li>{point}</li>)}</ul></div></article>))}</div><details class="section-more experience-more"><summary><span class="more-label-closed">See previous experience (3)</span><span class="more-label-open">Hide previous roles</span></summary><div class="timeline timeline-previous">{experience.filter((job) => !job.featured).map((job) => (<article class:list={["timeline-item", { "timeline-item-featured": job.featured }]}><div class="timeline-date">{job.date}</div><div class="timeline-marker"></div><div class="timeline-content">{job.featured && <div class="timeline-current-badge"><span class="timeline-status-dot"></span> CURRENT ROLE</div>}<p class="timeline-type">{job.type}</p><h3>{job.role}</h3><p class="timeline-org">{job.org}</p>{job.featured && <div class="timeline-tags">{job.tags.map((tag) => <span>{tag}</span>)}</div>}{job.featured && <p class="timeline-focus">Working across sourcing operations, international coordination, quality documentation, and engineering support.</p>}<ul>{job.points.map((point) => <li>{point}</li>)}</ul></div></article>))}</div></details></div></section>
  <section id="skills" class="section skills-section">
    <div class="shell">
      <div class="section-head skills-section-head">
        <div>
          <p class="eyebrow">Skills</p>
          <h2 class="section-title mt-5">What I use — and how I use it.</h2>
        </div>
        <p class="section-note">A practical view of the tools and technical capabilities behind my engineering, simulation, visualization, and sourcing work. The descriptions are grounded in my LinkedIn skills and project experience.</p>
      </div>
      <div class="skills-summary">
        <div class="skills-summary-item"><span class="skills-summary-number">25+</span><span>LinkedIn-listed skills</span></div>
        <div class="skills-summary-item"><span class="skills-summary-number">05</span><span>Core capability areas</span></div>
        <div class="skills-summary-item"><span class="skills-summary-number">01</span><span>Cross-disciplinary toolkit</span></div>
      </div>
      <div class="skills-detail-grid">
        {skillCategories.slice(0, 2).map((group, groupIndex) => (
          <article class="skill-detail-card" style={`--skill-delay: ${groupIndex * 70}ms`}>
            <div class="skill-detail-header">
              <div>
                <span class="skill-detail-number">0{groupIndex + 1}</span>
                <h3>{group.category}</h3>
              </div>
              <span class="skill-detail-arrow" aria-hidden="true">↗</span>
            </div>
            <p class="skill-detail-tagline">{group.tagline}</p>
            <div class="skill-items">
              {group.skills.map((skill) => (
                <div class="skill-item">
                  <div class="skill-item-top">
                    <h4>{skill.name}</h4>
                    <span class:list={['skill-level', `skill-level-${skill.level.toLowerCase()}`]}>{skill.level}</span>
                  </div>
                  {skill.note && <p>{skill.note}</p>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      <details class="section-more skills-more">
        <summary><span class="more-label-closed">See all 5 skill areas</span><span class="more-label-open">Hide expanded skills</span></summary>
        <div class="skills-detail-grid skills-detail-grid-expanded">
          {skillCategories.slice(2).map((group, index) => (
            <article class="skill-detail-card">
              <div class="skill-detail-header">
                <div>
                  <span class="skill-detail-number">0{index + 3}</span>
                  <h3>{group.category}</h3>
                </div>
                <span class="skill-detail-arrow" aria-hidden="true">↗</span>
              </div>
              <p class="skill-detail-tagline">{group.tagline}</p>
              <div class="skill-items">
                {group.skills.map((skill) => (
                  <div class="skill-item">
                    <div class="skill-item-top">
                      <h4>{skill.name}</h4>
                      <span class:list={['skill-level', 'skill-level-' + skill.level.toLowerCase()]}>{skill.level}</span>
                    </div>
                    {skill.note && <p>{skill.note}</p>}
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      <div class="skills-language-strip">
        <span class="skills-language-label">Programming</span>
        <span>C</span><span>C++</span><span>Python</span>
        <span class="skills-language-label skills-language-label-spaced">Technical focus</span>
        <span>CAD / CAE</span><span>CFD</span><span>Additive Manufacturing</span><span>Supply Chain &amp; Sourcing</span>
      </div>
      </details>
    </div>
  </section>


  <section id="achievements" class="section achievements-section">
    <div class="shell">
      <div class="section-head achievements-head">
        <div>
          <p class="eyebrow">Achievements</p>
          <h2 class="section-title mt-5">A milestone worth putting front and centre.</h2>
        </div>
        <p class="section-note">A dedicated highlight for one of my strongest recent achievements — the NVIDIA AI PC Day Award received with my team for CGI and VFX excellence.</p>
      </div>

      <article class="achievement-feature">
        <div class="achievement-hero">
          <div class="achievement-hero-image">
            <img src={`${base}media/Nvidia%20Award/1.jpeg`} alt="NVIDIA AI PC Day — Overall Champion achievement" loading="lazy" />
            <div class="achievement-image-overlay"><span>OVERALL CHAMPION</span><span>01 / 05</span></div>
          </div>
          <div class="achievement-hero-copy">
            <div class="achievement-kicker"><span class="achievement-star">★</span><span>NVIDIA · AI PC DAY</span></div>
            <h3>NVIDIA AI PC Day — Overall Champion</h3>
            <p class="achievement-lead">Industry-Grade CGI &amp; Simulation powered by NVIDIA RTX</p>
            <p class="achievement-description">A top-tier team achievement recognising an end-to-end production pipeline accelerated by NVIDIA RTX, with cinema-quality visuals and a professional-level rendering workflow.</p>
            <div class="achievement-tags">
              <span>OVERALL CHAMPION</span>
              <span>NVIDIA RTX</span>
              <span>TEAM ACHIEVEMENT</span>
            </div>
          </div>
        </div>

        <details class="section-more achievement-more"><summary><span class="more-label-closed">See award highlights &amp; all 5 photos</span><span class="more-label-open">Hide award details</span></summary><div class="achievement-highlights">
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">TOP-TIER ACHIEVEMENT</span>
            <strong>End-to-End Production Pipeline</strong>
            <p>Accelerated by NVIDIA RTX.</p>
          </div>
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">SIGNATURE ACHIEVEMENT</span>
            <strong>Cinema-Quality Visuals</strong>
            <p>Delivered using NVIDIA RTX AI.</p>
          </div>
          <div class="achievement-highlight-card">
            <span class="achievement-highlight-label">ELITE ACHIEVEMENT</span>
            <strong>Professional-Level Rendering Workflow</strong>
            <p>Validated on NVIDIA RTX.</p>
          </div>
        </div>

        <div class="achievement-gallery" aria-label="NVIDIA AI PC Day achievement photo gallery">
          {[
            ['2.jpeg', 'Award moment · 02 / 05'],
            ['3.jpeg', 'Team / event moment · 03 / 05'],
            ['4.jpeg', 'Achievement highlight · 04 / 05'],
            ['5.jpeg', 'Award memory · 05 / 05'],
          ].map(([file, label]) => (
            <a class="achievement-gallery-item" href={`${base}media/Nvidia%20Award/${file}`} target="_blank" rel="noreferrer" aria-label={`Open ${label}`}>
              <img src={`${base}media/Nvidia%20Award/${file}`} alt={`NVIDIA AI PC Day — ${label}`} loading="lazy" />
              <span>{label} ↗</span>
            </a>
          ))}
        </div>

        <div class="achievement-footer">
          <div><span class="achievement-footer-label">SIGNATURE IMPACT</span><strong>Creative excellence, technical capability, and team execution.</strong></div>
          <a href="#projects" class="text-link">See the work behind the craft <span>→</span></a>
        </div>
      </details></article>
    </div>
  </section>

  
  

  <section id="education" class="section credentials-section"><div class="shell credentials-grid"><div><p class="eyebrow">Education & Honors</p><h2 class="credential-title">Kumaraguru<br />College of Technology</h2><p class="credential-program">B.E. · Aeronautical Engineering · CGPA 7.9</p><p class="credential-date">October 2022 — April 2026</p><p class="muted mt-6">Focus areas include CFD, aerospace systems, design engineering, additive manufacturing, and technical visualization.</p><details class="section-more education-more"><summary><span class="more-label-closed">View school history</span><span class="more-label-open">Hide school history</span></summary><div class="school-history"><p><b>Class 12th, CBSE · 85%</b><span>June 2021 — March 2022 · Nava Bharath National School</span></p><p><b>Class 10th, CBSE · 80%</b><span>June 2019 — March 2020 · Nava Bharath National School</span></p></div></details><div class="achievement"><div class="flex items-center justify-between gap-2"><span>ATHLETIC HONORS</span><span class="tag">Record Holder</span></div><p class="font-semibold text-[var(--text-hi)] text-base mt-1">Asian Record Holder · Roller Skating</p><p class="text-xs text-[var(--text-mid)] mt-1">Reflecting dedication, discipline, endurance, and competitive resilience at the Asian continental level.</p></div></div><div><details class="section-more education-more"><summary><span class="more-label-closed">View training &amp; certifications (5)</span><span class="more-label-open">Hide certifications</span></summary><p class="eyebrow">Training & certifications</p><ul class="cert-list">{certifications.map(([name, meta], index) => <li><span>0{index + 1}</span><div><h3>{name}</h3><p>{meta}</p></div></li>)}</ul></details></div></div></section>
  <section id="contact" class="contact-section">
    <div class="shell contact-card contact-card-enhanced">
      <div class="contact-copy">
        <p class="eyebrow">Open to opportunities</p>
        <h2>Have a project or opportunity? <em>Let’s talk.</em></h2>
