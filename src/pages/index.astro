<script>
  // Keep project previews lazy and allow only an on-screen video to consume playback resources.
  const lazyProjectVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-src]'));
  const visibleProjectVideos = new Set<HTMLVideoElement>();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let activeProjectVideo: HTMLVideoElement | null = null;

  const pauseProjectVideo = (video: HTMLVideoElement) => {
    video.pause();
    if (activeProjectVideo === video) activeProjectVideo = null;
  };

  const activateProjectVideo = (video: HTMLVideoElement) => {
    if (document.hidden || reducedMotion || !visibleProjectVideos.has(video)) return;
    if (activeProjectVideo && activeProjectVideo !== video) pauseProjectVideo(activeProjectVideo);
    activeProjectVideo = video;

    if (!video.dataset.loaded) {
      const source = video.dataset.src;
      if (!source) return;
      video.src = source;
      video.dataset.loaded = 'true';
      video.load();
    }

    const playback = video.play();
    if (playback && typeof playback.catch === 'function') {
      playback.catch(() => {
        // Autoplay can be restricted by the browser; the page remains usable.
        if (activeProjectVideo === video) activeProjectVideo = null;
      });
    }
  };

  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target;
        if (!(video instanceof HTMLVideoElement)) return;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.2) {
          visibleProjectVideos.add(video);
          activateProjectVideo(video);
        } else {
          visibleProjectVideos.delete(video);
          pauseProjectVideo(video);
        }
      });
    }, { rootMargin: '100px 0px', threshold: [0, 0.2, 0.5] });

    lazyProjectVideos.forEach((video) => videoObserver.observe(video));
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      lazyProjectVideos.forEach(pauseProjectVideo);
    } else if (activeProjectVideo && visibleProjectVideos.has(activeProjectVideo)) {
      activateProjectVideo(activeProjectVideo);
    } else {
      const nextVisible = visibleProjectVideos.values().next().value;
      if (nextVisible) activateProjectVideo(nextVisible);
    }
  });

  window.addEventListener('pagehide', () => {
    lazyProjectVideos.forEach(pauseProjectVideo);
  });
</script>



<script>
  const popup = document.getElementById('honors-popup');
  const closeButton = document.getElementById('honors-popup-close');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.honors-slide'));
  const counter = document.getElementById('honors-popup-count');
  const honorsShownKey = 'gowtham-honors-popup-shown-at';
  const honorsCooldown = 24 * 60 * 60 * 1000;
  const slideDuration = 2000;
  let activeSlide = 0;
  let slideTimer: number | undefined;
  let popupClosed = false;

  const showSlide = (nextIndex: number) => {
    if (!slides.length) return;
    activeSlide = (nextIndex + slides.length) % slides.length;
    slides.forEach((slide, index) => {
      const isActive = index === activeSlide;
      slide.classList.toggle('is-active', isActive);
      slide.setAttribute('aria-hidden', String(!isActive));
      if (isActive) slide.removeAttribute('inert');
      else slide.setAttribute('inert', '');
    });
    if (counter) counter.textContent = `${String(activeSlide + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
  };

  const stopSlideshow = () => {
    if (slideTimer !== undefined) window.clearInterval(slideTimer);
    slideTimer = undefined;
  };
  const startSlideshow = () => {
    stopSlideshow();
    if (popupClosed || document.hidden || slides.length < 2) return;
    slideTimer = window.setInterval(() => showSlide(activeSlide + 1), slideDuration);
  };
  const closeHonorsPopup = () => {
    if (popupClosed) return;
    popupClosed = true;
    stopSlideshow();
    popup?.classList.add('honors-popup-hidden');
    window.setTimeout(() => popup?.remove(), 320);
  };

  const now = Date.now();
  let lastShown = 0;
  try { lastShown = Number.parseInt(localStorage.getItem(honorsShownKey) || '0', 10); } catch { lastShown = 0; }
  const shouldShow = !Number.isFinite(lastShown) || now - lastShown >= honorsCooldown;
  if (shouldShow) {
    try { localStorage.setItem(honorsShownKey, String(now)); } catch { /* Storage may be unavailable. */ }
    popup?.classList.remove('honors-popup-pending');
    showSlide(0);
    window.setTimeout(() => closeButton?.focus(), 80);
    startSlideshow();
  } else {
    popup?.remove();
    popupClosed = true;
  }

  closeButton?.addEventListener('click', closeHonorsPopup);
  popup?.addEventListener('click', (event) => {
    if (event.target === popup) closeHonorsPopup();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopSlideshow();
    else startSlideshow();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !popupClosed) closeHonorsPopup();
  });
</script>

<script>
  // Follow button: starts at 517 and grows by one for every visitor who follows (one per browser).
  const followCard = document.getElementById('follow-card');
  const followBtn = document.getElementById('follow-button') as HTMLButtonElement | null;
  const followLabel = document.getElementById('follow-label');
  const followCountEl = document.getElementById('follow-count');
  if (followCard && followBtn && followLabel && followCountEl) {
    const BASE = Number(followCard.dataset.base || '517');
    const API = 'https://api.counterapi.dev/v1/gowtham1745-portfolio/followers';
    const KEY = 'gowtham-portfolio-followed';
    let extra = 0;
    const render = () => { followCountEl.textContent = (BASE + extra).toLocaleString('en-IN'); };
    const setFollowed = () => { followBtn.classList.add('is-following'); followBtn.setAttribute('aria-pressed', 'true'); followLabel.textContent = 'Following ✓'; followBtn.disabled = true; };
    const fetchJson = async (url: string) => {
      const ctl = new AbortController();
      const t = window.setTimeout(() => ctl.abort(), 5000);
      try { const r = await fetch(url, { signal: ctl.signal }); if (!r.ok) throw new Error(String(r.status)); return await r.json(); }
      finally { window.clearTimeout(t); }
    };
    let followed = false;
    try { followed = localStorage.getItem(KEY) === '1'; } catch { followed = false; }
    if (followed) setFollowed();
    render();
    fetchJson(API + '/').then((d) => { const n = Number(d && d.count); if (Number.isFinite(n) && n >= 0) { extra = Math.max(extra, n); render(); } }).catch(() => { /* keep base count */ });
    followBtn.addEventListener('click', () => {
      if (followBtn.disabled) return;
      extra += 1; render(); setFollowed();
      try { localStorage.setItem(KEY, '1'); } catch { /* storage unavailable */ }
      fetchJson(API + '/up').then((d) => { const n = Number(d && d.count); if (Number.isFinite(n) && n >= extra) { extra = n; render(); } }).catch(() => { /* count stays local */ });
    });
  }
</script>

