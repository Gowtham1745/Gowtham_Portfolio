---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';

const base = import.meta.env.BASE_URL;

const experience = [
  { date: 'Feb 2026 — Present', role: 'Graduate Engineer Trainee (GET) — Sourcing Department', org: 'AMPO Valves India', type: 'Full-time · Coimbatore, India', points: ['Manage sourcing documentation in SAP, including delivery invoices for sea and air shipments.', 'Coordinate with the Spain-based team to track shipments and support accurate documentation.', 'Generate and update Material Identification Numbers (MIN) and QR codes for shipment tracking and verification.', 'Handle quality and compliance documentation: Heat Numbers, Material Test Certificates (MTC), and Radiographic Testing records.', 'Support SolidWorks design work and ANSYS simulation tasks.'] },
  { date: 'Jan 2024 — Apr 2026', role: 'Blender Animation · 3D Artist · Motion Graphics', org: 'Pixar Prince Animation Studio', type: 'Freelance · Coimbatore, India', points: ['Developed 3D animation and motion graphics in Blender.', 'Created CGI, visual effects, simulation, and cinematic visual work with a focus on timing, composition, and visual storytelling.'] },
  { date: 'July 2025', role: 'Electric Vehicle Battery & Motor Design', org: 'Dassault Systèmes', type: 'Internship · Coimbatore, India', points: ['Worked on EV battery-pack and motor-assembly design.', 'Applied CAD modeling to layout, feasibility, structural reliability, safety considerations, and lightweight integration.'] },
  { date: 'May 2025', role: 'RC Plane Design & Development', org: 'Jet Aerospace', type: 'Internship · Kerala, India', points: ['Contributed to aircraft concept development, aerodynamic design, CAD modeling, and lightweight structural design.', 'Worked on aircraft assembly, propulsion, ESC, servo, RC-control integration, and flight testing.'] },
];
const skillGroups = [
  { number: '01', label: 'Engineering analysis', items: ['ANSYS', 'CFD', 'Structural analysis', 'Aeronautical systems'] },
  { number: '02', label: 'Design & CAD', items: ['SolidWorks', 'CATIA', '3D printing', 'Design for additive manufacturing'] },
  { number: '03', label: 'Visualization', items: ['Unreal Engine 5.4', 'Blender', 'Nuke', 'After Effects'] },
  { number: '04', label: 'Operations', items: ['SAP', 'Shipment documentation', 'MTC / Heat Numbers / RT', 'International logistics'] },
];
const projectMedia: Record<string, { type: 'image' | 'video'; src: string }> = {
  'abhyaas-uav-s-duct': { type: 'image', src: `${base}media/cover.jpeg` },
  'rc-aircraft': { type: 'image', src: `${base}media/projects/rc-aircraft/1.jpeg` },
  'pandora-unreal-environment': { type: 'video', src: `${base}media/projects/pandora/environment-art.mp4` },
  'the-horizon': { type: 'video', src: `${base}media/projects/pandora/the-horizon.mp4` },
  'ancient-stillness': { type: 'video', src: `${base}media/projects/pandora/ancient-stillness.mp4` },
  'contra-rotating-vawt': { type: 'image', src: `${base}media/projects/vawt.jpeg` },
  'drone-additive-manufacturing': { type: 'image', src: `${base}media/projects/drone/3.jpeg` },
  'ev-battery-motor-design': { type: 'image', src: `${base}media/projects/ev-design/1.jpeg` },
};
const certifications = [['ANSYS Virtual Intern in Fluid Dynamics', 'Computational fluid dynamics & aerodynamic analysis'], ['Drone Design & Structural Analysis', 'UAV structural evaluation, payload & airframe sizing'], ['Electric Vehicle Battery & Motor', 'Dassault Systèmes — EV powertrain & structural safety'], ['Blender Digital Sculpting', '3D CGI, photorealistic lighting & animation'], ['RC Plane Design & Development', 'Jet Aerospace — flight aerodynamics & RC integration']];
---
<Layout title="Portfolio" description="Gowtham A — Aeronautical Engineering graduate working across design, simulation, real-time visualization, and sourcing operations.">
  <div class="honors-popup-backdrop" id="honors-popup" role="presentation">
    <aside class="honors-popup" role="dialog" aria-modal="true" aria-labelledby="honors-popup-title">
      <button class="honors-popup-close" id="honors-popup-close" type="button" aria-label="Close athletic honors">×</button>
      <div class="honors-popup-layout">
        <div class="honors-popup-photo">
          <img src={`${base}media/profile-professional.jpg`} alt="Gowtham A" />
        </div>
        <div class="honors-popup-content">
          <div class="honors-popup-badge"><span class="honors-medal">★</span><span>ATHLETIC HONORS</span></div>
          <p class="honors-popup-kicker">Record Holder</p>
          <h2 id="honors-popup-title">Asian Record Holder</h2>
          <p class="honors-popup-sport">Roller Skating</p>
          <div class="honors-popup-line"></div>
          <p class="honors-popup-copy">A lifetime milestone reflecting dedication, discipline, endurance, and competitive resilience at the Asian continental level.</p>
          <div class="honors-popup-footer"><span>ASIAN RECORD</span><span aria-hidden="true">✦</span><span>PROUD MILESTONE</span></div>
        </div>
      </div>
    </aside>
  </div>

  <section class="hero"><div class="hero-grid"></div><div class="hero-orbit"></div><div class="shell hero-content"><div class="hero-copy reveal"><p class="eyebrow">Gowtham A · Coimbatore, India</p><h1>Engineering <em>systems</em>.<br />Visualizing what’s next.</h1><p class="hero-intro">Aeronautical Engineering graduate and Graduate Engineer Trainee in Sourcing. I work across design engineering, simulation, real-time visualization, and global operations.</p><div class="hero-actions"><a href="#projects" class="button">Explore selected work <span aria-hidden="true">↓</span></a><a href="#contact" class="button button-secondary">Get in touch</a></div><div class="hero-meta"><span><b>Based in</b> Tamil Nadu, India</span><span><b>Currently</b> AMPO Valves India</span></div></div><div class="portrait-container reveal"><div class="portrait-wrap"><div class="portrait-frame"><img src={`${base}media/profile-professional.jpg`} alt="Portrait of Gowtham A" class="portrait" loading="eager" /><div class="corner corner-tl"></div><div class="corner corner-br"></div></div><div class="portrait-caption"><span class="pulse"></span> Gowtham A · available for the next challenge</div></div></div></div></section>
  <section id="about" class="section about-section"><div class="shell about-grid"><div><p class="eyebrow">About</p><h2 class="section-title mt-5">A cross-disciplinary engineering practice.</h2></div><div class="about-copy"><p>I work at the intersection of design engineering, real-time visualization, and global operations. At AMPO Valves India, my day-to-day includes SAP-based shipment documentation, customs-clearance support, coordination with Spain-based teams, quality and compliance records, and CAD / simulation support.</p><p>My B.E. in Aeronautical Engineering at Kumaraguru College of Technology culminated in an ABHYAAS UAV S-duct intake project: CFD analysis, design optimization, 3D printing, and wind tunnel validation. Alongside engineering, I’ve developed a CGI and real-time visualization practice through Blender, Unreal Engine, and After Effects.</p><a href="#experience" class="text-link">Read the experience timeline <span>→</span></a></div></div></section>
  <section id="projects" class="section projects-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title mt-5">Projects built across physical and digital systems.</h2></div><p class="section-note">Every project image is matched to the work shown. Where supporting media is not yet available, the card uses a technical placeholder instead.</p></div><div class="project-grid">{projects.map((project, index) => { const media = projectMedia[project.slug]; return (<article class:list={['project-card', `project-card-${project.slug}`, { 'project-card-featured': index === 0 || index === 2 }]}><div class="project-category">{project.category}</div><div class="project-image">{media?.type === 'video' ? <video src={media.src} muted autoplay loop playsinline preload="metadata" aria-label={`${project.title} video preview`}></video> : media ? <img src={media.src} alt="" loading={index < 3 ? 'eager' : 'lazy'} /> : <div class="project-placeholder"><span>PROJECT<br />MEDIA</span><i></i></div>}</div><div class="project-body"><div class="project-number">0{index + 1} / {project.year}</div><h3>{project.title}</h3><p>{project.blurb}</p><div class="project-footer"><div class="project-tools">{project.tools.slice(0, 3).map((tool) => <span>{tool}</span>)}</div>{project.href ? <a href={`${base}${project.href.replace(/^\//, "")}`} aria-label={`Read ${project.title} project`}>View <span>↗</span></a> : <span class="project-status">Project overview</span>}</div></div></article>); })}</div></div></section>
  <section id="experience" class="section timeline-section"><div class="shell"><div class="section-head"><div><p class="eyebrow">Experience</p><h2 class="section-title mt-5">Work shaped by detail.</h2></div></div><div class="timeline">{experience.map((job) => (<article class="timeline-item"><div class="timeline-date">{job.date}</div><div class="timeline-marker"></div><div class="timeline-content"><p class="timeline-type">{job.type}</p><h3>{job.role}</h3><p class="timeline-org">{job.org}</p><ul>{job.points.map((point) => <li>{point}</li>)}</ul></div></article>))}</div></div></section>
  <section id="skills" class="section skills-section"><div class="shell"><p class="eyebrow">Capabilities</p><div class="skills-heading"><h2 class="section-title">Tools for thinking, making, and communicating.</h2><p class="section-note">A practical toolkit spanning engineering analysis, CAD, visualization, and operations. Technical languages: C, C++, and Python.</p></div><div class="skills-grid">{skillGroups.map((group) => (<div class="skill-group"><span>{group.number}</span><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></div>))}</div></div></section>
  <section id="education" class="section credentials-section"><div class="shell credentials-grid"><div><p class="eyebrow">Education & Honors</p><h2 class="credential-title">Kumaraguru<br />College of Technology</h2><p class="credential-program">B.E. · Aeronautical Engineering · CGPA 7.9</p><p class="credential-date">October 2022 — April 2026</p><p class="muted mt-6">Focus areas include CFD, aerospace systems, design engineering, additive manufacturing, and technical visualization.</p><div class="school-history"><p><b>Class 12th, CBSE · 85%</b><span>June 2021 — March 2022 · Nava Bharath National School</span></p><p><b>Class 10th, CBSE · 80%</b><span>June 2019 — March 2020 · Nava Bharath National School</span></p></div><div class="achievement"><div class="flex items-center justify-between gap-2"><span>ATHLETIC HONORS</span><span class="tag">Record Holder</span></div><p class="font-semibold text-[var(--text-hi)] text-base mt-1">Asian Record Holder · Roller Skating</p><p class="text-xs text-[var(--text-mid)] mt-1">Reflecting dedication, discipline, endurance, and competitive resilience at the Asian continental level.</p></div></div><div><p class="eyebrow">Training & certifications</p><ul class="cert-list">{certifications.map(([name, meta], index) => <li><span>0{index + 1}</span><div><h3>{name}</h3><p>{meta}</p></div></li>)}</ul></div></div></section>
  <section id="contact" class="contact-section"><div class="shell contact-card"><div><p class="eyebrow">Contact</p><h2>Let’s build something that moves <em>forward.</em></h2><p>Open to roles and collaborations in design engineering, simulation, sourcing, and technical visualization.</p></div><div class="contact-links"><a href="mailto:gowthamgo1745@gmail.com">Email <span>↗</span></a><a href="https://www.linkedin.com/in/gowtham1745/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://github.com/Gowtham1745" target="_blank" rel="noreferrer">GitHub <span>↗</span></a><a href="https://wa.me/917539982255" target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a></div></div></section>
</Layout>

<script>
  const popup = document.getElementById('honors-popup');
  const closeButton = document.getElementById('honors-popup-close');
  const honorsShownKey = 'gowtham-honors-popup-shown-at';
  const honorsCooldown = 24 * 60 * 60 * 1000;

  const now = Date.now();
  const lastShown = Number.parseInt(localStorage.getItem(honorsShownKey) || '0', 10);
  const shouldShow = !Number.isFinite(lastShown) || now - lastShown >= honorsCooldown;

  if (shouldShow) {
    localStorage.setItem(honorsShownKey, String(now));
    popup?.classList.remove('honors-popup-pending');
  } else {
    popup?.remove();
  }

  const closeHonorsPopup = () => {
    popup?.classList.add('honors-popup-hidden');
    window.setTimeout(() => popup?.remove(), 320);
  };

  closeButton?.addEventListener('click', closeHonorsPopup);
  popup?.addEventListener('click', (event) => {
    if (event.target === popup) closeHonorsPopup();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeHonorsPopup();
  });
</script>

<style>
.honors-popup-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 1.25rem;
  background: rgba(2, 8, 13, 0.48);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  animation: honors-backdrop-in 0.45s ease both;
}
.honors-popup-pending { display: none !important; }
.honors-popup {
  position: relative;
  width: min(100%, 680px);
  padding: 2rem 2rem 1.45rem;
  overflow: hidden;
  border: 1px solid rgba(231, 184, 102, 0.62);
  border-radius: 18px;
  background:
    radial-gradient(circle at 85% 8%, rgba(231, 184, 102, 0.2), transparent 32%),
    radial-gradient(circle at 10% 100%, rgba(98, 203, 189, 0.13), transparent 36%),
    linear-gradient(145deg, #102532, #07131d 72%);
  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.65),
    0 0 0 1px rgba(255, 255, 255, 0.04) inset,
    0 0 45px rgba(231, 184, 102, 0.13);
  animation: honors-popup-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.honors-popup-layout {
  position: relative;
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 1.4rem;
  align-items: center;
}
.honors-popup-photo {
  width: 150px;
  height: 185px;
  overflow: hidden;
  border: 2px solid rgba(255,255,255,0.92);
  border-radius: 15px;
  background: #07131d;
  box-shadow: 0 14px 35px rgba(0,0,0,0.45), 0 0 24px rgba(98,203,189,0.16);
}
.honors-popup-photo img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center 12%;
}
.honors-popup-content {
  min-width: 0;
}
.honors-popup::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(115deg, transparent 15%, rgba(255,255,255,0.07) 48%, transparent 62%);
  transform: translateX(-120%);
  animation: honors-shine 1.4s 0.35s ease-out both;
}
.honors-popup-close {
  position: absolute;
  top: 0.75rem;
  right: 0.8rem;
  z-index: 2;
  width: 2rem;
  height: 2rem;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,0.13);
  border-radius: 50%;
  background: rgba(0,0,0,0.2);
  color: var(--text-mid);
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  transition: 0.2s ease;
}
.honors-popup-close:hover {
  color: var(--text-hi);
  border-color: rgba(231,184,102,0.65);
  transform: rotate(90deg);
}
.honors-popup-badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--amber);
  font: 700 0.66rem 'IBM Plex Mono', monospace;
  letter-spacing: 0.12em;
}
.honors-medal {
  width: 1.45rem;
  height: 1.45rem;
  display: grid;
  place-items: center;
  border: 1px solid rgba(231,184,102,0.75);
  border-radius: 50%;
  background: rgba(231,184,102,0.12);
  box-shadow: 0 0 18px rgba(231,184,102,0.16);
  font-size: 0.68rem;
}
.honors-popup-kicker {
  position: relative;
  margin-top: 1.35rem;
  color: var(--teal);
  font: 600 0.68rem 'IBM Plex Mono', monospace;
  text-transform: uppercase;
  letter-spacing: 0.16em;
}
.honors-popup h2 {
  position: relative;
  margin-top: 0.42rem;
  padding-right: 2rem;
  color: var(--text-hi);
  font-size: clamp(1.8rem, 6vw, 2.45rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
}
.honors-popup-sport {
  position: relative;
  margin-top: 0.35rem;
  color: var(--amber);
  font-size: 1rem;
  font-weight: 600;
}
.honors-popup-line {
  position: relative;
  width: 70px;
  height: 2px;
  margin: 1.25rem 0 1rem;
  background: linear-gradient(90deg, var(--amber), var(--teal));
}
.honors-popup-copy {
  position: relative;
  color: var(--text-mid);
  font-size: 0.84rem;
  line-height: 1.65;
  max-width: 42ch;
}
.honors-popup-footer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  margin-top: 1.35rem;
  padding-top: 0.9rem;
  border-top: 1px solid rgba(255,255,255,0.1);
  color: var(--text-low);
  font: 600 0.58rem 'IBM Plex Mono', monospace;
  letter-spacing: 0.1em;
}
.honors-popup-footer span:nth-child(2) {
  color: var(--amber);
}
.honors-popup-hidden {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
@keyframes honors-popup-in {
  from { opacity: 0; transform: translateY(18px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes honors-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes honors-shine {
  to { transform: translateX(120%); }
}

@media (max-width: 520px) {
  .honors-popup-backdrop {
    padding: 1rem;
  }
  .honors-popup {
    width: min(88vw, 360px);
    max-height: none;
    overflow: hidden;
    padding: 1rem 0.9rem 0.85rem;
    border-radius: 15px;
  }
  .honors-popup-layout {
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }
  .honors-popup-photo {
    width: 72px;
    height: 94px;
    border-radius: 10px;
  }
  .honors-popup-close {
    top: 0.45rem;
    right: 0.45rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(231,184,102,0.45);
    background: rgba(7,17,26,0.78);
    color: var(--text-hi);
    font-size: 1.45rem;
    font-weight: 500;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  }
  .honors-popup-close:hover {
    background: rgba(231,184,102,0.12);
    border-color: var(--amber);
  }
  .honors-popup-badge {
    gap: 0.4rem;
    font-size: 0.53rem;
    letter-spacing: 0.09em;
  }
  .honors-medal {
    width: 1.2rem;
    height: 1.2rem;
    font-size: 0.58rem;
  }
  .honors-popup-kicker {
    margin-top: 0.65rem;
    font-size: 0.54rem;
    letter-spacing: 0.12em;
  }
  .honors-popup h2 {
    font-size: clamp(1.18rem, 6vw, 1.55rem);
    line-height: 1.04;
    padding-right: 1.9rem;
  }
  .honors-popup-sport {
    font-size: 0.78rem;
    margin-top: 0.28rem;
  }
  .honors-popup-line {
    width: 52px;
    margin: 0.65rem 0 0.55rem;
  }
  .honors-popup-copy {
    font-size: 0.67rem;
    line-height: 1.42;
  }
  .honors-popup-footer {
    font-size: 0.42rem;
    margin-top: 0.7rem;
    padding-top: 0.55rem;
    letter-spacing: 0.07em;
  }
}
@media (min-width: 521px) and (max-width: 900px) {
  .honors-popup {
    width: min(92vw, 680px);
  }
}

.hero {
  min-height: min(840px, 100vh);
  display: grid;
  place-items: center;
  overflow: hidden;
  position: relative;
  border-bottom: 1px solid var(--line);
  background: radial-gradient(circle at 75% 45%, rgba(56, 116, 122, 0.22), transparent 32rem),
              linear-gradient(120deg, #07111a 10%, #0a1923 100%);
}
.hero-grid {
  position: absolute;
  inset: 0;
  opacity: 0.3;
  background-image: linear-gradient(rgba(106, 155, 161, 0.14) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(106, 155, 161, 0.14) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: linear-gradient(to bottom, #000, transparent);
}
.hero-orbit {
  position: absolute;
  width: min(70vw, 800px);
  aspect-ratio: 1;
  border: 1px solid rgba(98, 203, 189, 0.2);
  border-radius: 50%;
  left: 54%;
  top: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 5rem rgba(98, 203, 189, 0.025), 0 0 0 12rem rgba(98, 203, 189, 0.015);
  pointer-events: none;
}
.hero-content {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: center;
  padding-block: clamp(4.5rem, 8vw, 8rem) 4rem;
  position: relative;
}
.hero-copy h1 {
  margin: 1.4rem 0 1.6rem;
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  line-height: 0.95;
  font-weight: 600;
  max-width: 9.5ch;
}
h1 em, .contact-card em {
  color: var(--amber);
  font-family: Georgia, serif;
  font-weight: 400;
}
.hero-intro {
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  line-height: 1.7;
  color: var(--text-mid);
  max-width: 53ch;
}
.hero-actions {
  display: flex;
  gap: 0.85rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1.2rem;
  margin-top: 3rem;
  color: var(--text-low);
  font-size: 0.82rem;
}
.hero-meta b {
  color: var(--text-hi);
  font-weight: 500;
  margin-right: 0.35rem;
}
.portrait-container {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.portrait-wrap {
  position: relative;
  width: min(100%, 280px);
}
.portrait-frame {
  position: relative;
  width: 280px;
  height: 280px;
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  border: 3.5px solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.75), 0 0 25px rgba(255, 255, 255, 0.2), 0 0 45px rgba(98, 203, 189, 0.18);
  background: var(--ink-1);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
}
.portrait-frame:hover {
  transform: translateY(-4px);
  box-shadow: 0 25px 55px -10px rgba(0, 0, 0, 0.85), 0 0 35px rgba(255, 255, 255, 0.35), 0 0 55px rgba(98, 203, 189, 0.3);
}
.portrait {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 12%;
  filter: contrast(1.04) brightness(1.02);
  display: block;
}
.corner {
  position: absolute;
  width: 16px;
  height: 16px;
  border-color: var(--amber);
  pointer-events: none;
  z-index: 2;
}
.corner-tl { top: 6px; left: 6px; border-top: 2px solid; border-left: 2px solid; }
.corner-br { bottom: 6px; right: 6px; border-bottom: 2px solid; border-right: 2px solid; }
.portrait-caption {
